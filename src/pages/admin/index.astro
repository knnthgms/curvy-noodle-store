---
// Standalone admin page — no BaseLayout, full HTML document
// Talks to the GitHub API directly from the browser using a PAT stored in sessionStorage
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curvy Noodle · Admin</title>
  <script is:inline src="https://cdn.jsdelivr.net/npm/js-yaml@4/dist/js-yaml.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
  <script is:inline src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pink:      #d98a8a;
      --pink-dark: #b86b6b;
      --bg:        #f7f4f0;
      --card:      #ffffff;
      --border:    #e2dbd4;
      --text:      #2c2a27;
      --soft:      #7a746e;
      --danger:    #c0392b;
      --success:   #2e7d32;
      --radius:    12px;
      --shadow:    0 2px 10px rgba(0,0,0,.08);
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
    }

    /* ---------- layout ---------- */
    header {
      background: var(--card);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    header .logo { font-weight: 700; font-size: 1.1rem; }
    header .logo span { color: var(--pink); }
    header nav { margin-left: auto; display: flex; gap: .5rem; align-items: center; }

    main { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem; }

    /* ---------- cards / sections ---------- */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem;
    }
    .card + .card { margin-top: 1.25rem; }

    h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem; }
    h2 { font-size: 1.15rem; font-weight: 600; margin-bottom: 1rem; }

    /* ---------- buttons ---------- */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .5rem 1.1rem;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: .9rem;
      font-weight: 500;
      transition: opacity .15s, background .15s;
      text-decoration: none;
    }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    .btn-primary { background: var(--pink); color: #fff; }
    .btn-primary:hover:not(:disabled) { background: var(--pink-dark); }
    .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
    .btn-ghost:hover { background: var(--bg); }
    .btn-sm { padding: .35rem .75rem; font-size: .82rem; }

    /* ---------- forms ---------- */
    .field { margin-bottom: 1.1rem; }
    .field label {
      display: block;
      font-size: .85rem;
      font-weight: 600;
      color: var(--soft);
      text-transform: uppercase;
      letter-spacing: .04em;
      margin-bottom: .35rem;
    }
    .field input[type=text],
    .field input[type=number],
    .field input[type=date],
    .field input[type=password],
    .field select,
    .field textarea {
      width: 100%;
      padding: .55rem .75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      font-size: .95rem;
      color: var(--text);
      transition: border-color .15s;
    }
    .field input:focus,
    .field select:focus,
    .field textarea:focus { outline: none; border-color: var(--pink); }
    .field textarea { resize: vertical; min-height: 90px; font-family: inherit; }
    .field small { display: block; margin-top: .3rem; color: var(--soft); font-size: .8rem; }
    .field code { background: #f0ebe5; padding: .1em .35em; border-radius: 4px; font-size: .82em; }

    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .input-with-btn { display: flex; gap: .5rem; align-items: flex-start; }
    .input-with-btn input { flex: 1; }

    /* ---------- tag pills ---------- */
    .tag-pill-box {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
      padding: .45rem .5rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      cursor: text;
      min-height: 42px;
      align-items: center;
      transition: border-color .15s;
    }
    .tag-pill-box:focus-within { border-color: var(--pink); }
    .tag-chip {
      display: inline-flex;
      align-items: center;
      gap: .25rem;
      background: #fdeaea;
      color: var(--pink-dark);
      border-radius: 20px;
      padding: .18rem .55rem;
      font-size: .82rem;
      font-weight: 500;
      white-space: nowrap;
    }
    .tag-chip-remove {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--pink-dark);
      padding: 0 .1rem;
      line-height: 1;
      font-size: 1rem;
      opacity: .6;
      display: inline-flex;
      align-items: center;
    }
    .tag-chip-remove:hover { opacity: 1; }
    .tag-pill-input {
      border: none;
      outline: none;
      font-size: .9rem;
      min-width: 100px;
      flex: 1;
      background: transparent;
      color: var(--text);
      padding: .1rem .2rem;
    }

    /* ---------- gallery list ---------- */
    .list-items { display: flex; flex-direction: column; gap: .5rem; }
    .list-item { display: flex; gap: .5rem; align-items: flex-start; }
    .list-item .grow { flex: 1; }
    .btn-remove {
      padding: .45rem .6rem;
      border-radius: 6px;
      background: #fee2e2;
      color: var(--danger);
      border: none;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .btn-remove:hover { background: #fecaca; }
    .add-item-btn {
      margin-top: .5rem;
      background: transparent;
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: .45rem 1rem;
      cursor: pointer;
      color: var(--soft);
      font-size: .88rem;
      width: 100%;
    }
    .add-item-btn:hover { border-color: var(--pink); color: var(--pink); background: #fdf5f5; }
    .gallery-item { background: var(--bg); border-radius: 8px; padding: .75rem; width: 100%; }
    .gallery-item .field { margin-bottom: .6rem; }
    .gallery-item .field:last-child { margin-bottom: 0; }

    /* ---------- image picker modal ---------- */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.45);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: 0 8px 40px rgba(0,0,0,.25);
      width: 100%;
      max-width: 680px;
      max-height: 80vh;
      display: flex;
      flex-direction: column;
    }
    .modal-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: .5rem;
      flex-shrink: 0;
    }
    .modal-header h3 { flex: 1; font-size: 1rem; font-weight: 600; margin: 0; }
    .modal-body { padding: 1.25rem; overflow-y: auto; flex: 1; }
    .img-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: .75rem;
    }
    .img-thumb {
      aspect-ratio: 1;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid var(--border);
      cursor: pointer;
      position: relative;
      background: var(--bg);
      transition: border-color .15s, transform .1s;
    }
    .img-thumb:hover { border-color: var(--pink); transform: scale(1.03); }
    .img-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .img-thumb .img-name {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: rgba(0,0,0,.6);
      color: #fff;
      font-size: .62rem;
      padding: .2rem .3rem;
      word-break: break-all;
      line-height: 1.2;
    }

    /* ---------- list cards ---------- */
    .list-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .list-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: .75rem;
      transition: border-color .15s, box-shadow .15s;
    }
    .list-card:hover { border-color: var(--pink); box-shadow: 0 4px 16px rgba(217,138,138,.18); }
    .list-card-body { flex: 1; }
    .list-card-title { font-weight: 600; font-size: .95rem; margin-bottom: .25rem; line-height: 1.3; }
    .list-card-meta { font-size: .8rem; color: var(--soft); }
    .list-card-desc {
      font-size: .82rem;
      color: var(--soft);
      margin-top: .4rem;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .list-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: .75rem;
      border-top: 1px solid var(--border);
    }
    .list-card-price { font-weight: 700; font-size: 1rem; }
    .badges { display: flex; gap: .35rem; flex-wrap: wrap; margin-top: .5rem; }
    .badge {
      padding: .12rem .55rem;
      border-radius: 20px;
      font-size: .7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .02em;
    }
    .badge-featured { background: #fef3c7; color: #92400e; }
    .badge-sale     { background: #dcfce7; color: #166534; }
    .badge-draft    { background: #f3f4f6; color: #6b7280; }
    .badge-tag      { background: #f0ebe5; color: var(--soft); }

    /* ---------- status ---------- */
    .status {
      padding: .75rem 1rem;
      border-radius: 8px;
      font-size: .9rem;
      margin-bottom: 1.25rem;
    }
    .status.success { background: #e8f5e9; color: var(--success); border: 1px solid #c8e6c9; }
    .status.error   { background: #ffebee; color: var(--danger);  border: 1px solid #ffcdd2; }
    .status.info    { background: #e3f2fd; color: #1565c0;        border: 1px solid #bbdefb; }

    /* ---------- login ---------- */
    .login-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 56px);
      padding: 2rem 1rem;
    }
    .login-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 2rem;
      width: 100%;
      max-width: 440px;
    }
    .login-box h1 { text-align: center; margin-bottom: .5rem; }
    .login-box p  { text-align: center; color: var(--soft); font-size: .9rem; margin-bottom: 1.5rem; }

    /* ---------- home grid ---------- */
    .home-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .home-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem;
      cursor: pointer;
      transition: border-color .15s, box-shadow .15s;
    }
    .home-card:hover { border-color: var(--pink); box-shadow: 0 4px 16px rgba(217,138,138,.2); }
    .home-card .icon { font-size: 2.2rem; margin-bottom: .5rem; }
    .home-card h2 { margin: 0 0 .25rem; font-size: 1.1rem; }
    .home-card p { color: var(--soft); font-size: .88rem; margin: 0; }

    /* ---------- breadcrumb ---------- */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .88rem;
      color: var(--soft);
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--pink); text-decoration: none; cursor: pointer; }
    .breadcrumb a:hover { text-decoration: underline; }

    /* ---------- help ---------- */
    .help-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .help-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
    }
    .help-card h3 { font-size: .95rem; font-weight: 600; margin-bottom: .75rem; }
    .help-card p, .help-card li { font-size: .88rem; color: var(--soft); line-height: 1.65; }
    .help-card ul { padding-left: 1.25rem; }
    .help-card li { margin-bottom: .3rem; }
    .help-card code { background: #f0ebe5; padding: .1em .35em; border-radius: 4px; font-size: .82em; color: var(--text); }
    .help-card a { color: var(--pink); text-decoration: none; }
    .help-card a:hover { text-decoration: underline; }
    .md-ref { display: grid; grid-template-columns: auto 1fr; gap: .3rem .75rem; font-size: .83rem; margin-top: .25rem; }
    .md-ref dt { font-weight: 600; color: var(--text); white-space: nowrap; }
    .md-ref dd { color: var(--soft); font-family: monospace; font-size: .8rem; }

    /* ---------- loading ---------- */
    .loading { text-align: center; padding: 3rem; color: var(--soft); }
    .spinner {
      display: inline-block;
      width: 32px; height: 32px;
      border: 3px solid var(--border);
      border-top-color: var(--pink);
      border-radius: 50%;
      animation: spin .7s linear infinite;
      margin-bottom: .75rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ---------- form actions ---------- */
    .form-actions {
      display: flex;
      gap: .75rem;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      margin-top: 1.5rem;
    }
    .form-actions .spacer { flex: 1; }

    /* ---------- EasyMDE overrides ---------- */
    .EasyMDEContainer { font-size: .9rem; }
    .EasyMDEContainer .CodeMirror {
      border-radius: 0 0 8px 8px;
      border-color: var(--border);
      font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
      font-size: .88rem;
      min-height: 220px;
    }
    .editor-toolbar { border-radius: 8px 8px 0 0; border-color: var(--border); }
    .editor-toolbar button:hover, .editor-toolbar button.active {
      background: #fdeaea;
      border-color: var(--border);
    }
    .editor-preview, .editor-preview-side {
      font-size: .9rem;
      line-height: 1.7;
      padding: 1rem 1.25rem;
    }
    .editor-preview h1, .editor-preview h2, .editor-preview h3 { margin: 1em 0 .5em; }
    .editor-preview p { margin-bottom: .75em; }

    @media (max-width: 640px) {
      .home-grid { grid-template-columns: 1fr; }
      .field-row { grid-template-columns: 1fr; }
      .list-cards { grid-template-columns: 1fr; }
      .help-grid { grid-template-columns: 1fr; }
      .input-with-btn { flex-direction: column; }
      .input-with-btn input { width: 100%; }
    }
  </style>
</head>
<body>

<header>
  <div class="logo">🍜 Curvy Noodle <span>Admin</span></div>
  <nav id="header-nav"></nav>
</header>

<div id="app"></div>

<script is:inline>
/* ============================================================
   Config
   ============================================================ */
const OWNER        = 'knnthgms';
const REPO         = 'curvy-noodle-store';
const BRANCH       = 'main';
const PRODUCTS_DIR = 'src/content/products';
const BLOG_DIR     = 'src/content/blog';

/* ============================================================
   State
   ============================================================ */
let token       = sessionStorage.getItem('gh_token') || '';
let screen      = token ? 'home' : 'login';
let screenData  = {};
let statusMsg   = null;
let currentTags = [];   // maintained across add/remove while on an edit screen
let mdeInstance = null; // EasyMDE instance, destroyed on every navigate

/* ============================================================
   GitHub API helpers
   ============================================================ */
async function ghFetch(path, opts) {
  opts = opts || {};
  var baseHeaders = { Accept: 'application/vnd.github.v3+json', 'Content-Type': 'application/json' };
  if (token) baseHeaders['Authorization'] = 'token ' + token;
  const res = await fetch('https://api.github.com' + path, Object.assign({}, opts, {
    headers: Object.assign(baseHeaders, opts.headers || {}),
  }));
  if (!res.ok) {
    const err = await res.json().catch(function() { return {}; });
    throw new Error(err.message || 'GitHub error ' + res.status);
  }
  return res.json();
}

async function listFiles(dir) {
  return ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/' + dir + '?ref=' + BRANCH);
}

async function getFile(filePath) {
  const data = await ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/' + filePath + '?ref=' + BRANCH);
  const raw = atob(data.content.replace(/\n/g, ''));
  let content;
  try { content = decodeURIComponent(escape(raw)); } catch(e) { content = raw; }
  return { content: content, sha: data.sha, path: data.path };
}

async function putFile(filePath, content, sha, message) {
  let encoded;
  try { encoded = btoa(unescape(encodeURIComponent(content))); }
  catch(e) { encoded = btoa(content); }
  await ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/' + filePath, {
    method: 'PUT',
    body: JSON.stringify({ message: message, content: encoded, sha: sha, branch: BRANCH }),
  });
}

/* ============================================================
   Markdown / YAML helpers
   ============================================================ */
function parseMd(raw) {
  const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
  if (!m) return { fm: {}, body: raw };
  try { return { fm: jsyaml.load(m[1]) || {}, body: m[2] }; }
  catch(e) { return { fm: {}, body: raw }; }
}

function buildMd(fm, body) {
  const yaml = jsyaml.dump(fm, { lineWidth: -1, noCompatMode: true });
  return '---\n' + yaml.trimEnd() + '\n---\n' + body;
}

/* ============================================================
   Utilities
   ============================================================ */
function esc(s) {
  if (s == null) return '';
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function go(s, data) {
  screen = s;
  screenData = data || {};
  statusMsg = null;
  render();
}

function render() {
  if (mdeInstance) { try { mdeInstance.toTextArea(); } catch(e) {} mdeInstance = null; }
  document.getElementById('app').innerHTML = screens[screen]();

  var nav = '';
  if (token) {
    nav = '<button class="btn btn-ghost btn-sm" onclick="go(\'home\')">Home</button>' +
          '<button class="btn btn-ghost btn-sm" onclick="go(\'help\')">Help</button>' +
          '<button class="btn btn-ghost btn-sm" onclick="logout()">Sign out</button>';
  } else if (screen !== 'login') {
    nav = '<button class="btn btn-ghost btn-sm" onclick="go(\'help\')">Help</button>' +
          '<button class="btn btn-primary btn-sm" onclick="go(\'login\')">Sign in</button>';
  }
  document.getElementById('header-nav').innerHTML = nav;
  bindEvents();
}

function logout() {
  sessionStorage.removeItem('gh_token');
  token = '';
  go('login');
}

function showStatus(type, text) {
  statusMsg = { type: type, text: text };
  const existing = document.getElementById('status-msg');
  const div = document.createElement('div');
  div.className = 'status ' + type;
  div.id = 'status-msg';
  div.textContent = text;
  if (existing) {
    existing.replaceWith(div);
  } else {
    const container = document.querySelector('main') || document.querySelector('.login-box');
    if (container) container.prepend(div);
  }
}

function renderStatus() {
  if (!statusMsg) return '';
  return '<div class="status ' + statusMsg.type + '" id="status-msg">' + esc(statusMsg.text) + '</div>';
}

/* ============================================================
   Screens
   ============================================================ */
var screens = {};

/* --- Login --- */
screens.login = function() {
  return '<div class="login-wrap"><div class="login-box">' +
    '<h1>🍜 Admin</h1>' +
    '<p>Sign in with a GitHub personal access token that has <strong>Contents: Read &amp; Write</strong> permission for this repo.</p>' +
    renderStatus() +
    '<div class="field"><label>GitHub Personal Access Token</label>' +
    '<input type="password" id="tok-input" placeholder="github_pat_…" autocomplete="off" />' +
    '<small>Create one at <a href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener">github.com/settings/tokens</a> — fine-grained, this repo only, Contents: Read &amp; Write. Saved only for this browser tab. <a onclick="go(\'help\')" href="#" onclick="return false">Need help?</a></small></div>' +
    '<button class="btn btn-primary" id="login-btn" style="width:100%;margin-bottom:.75rem">Sign in</button>' +
    '<button type="button" class="btn btn-ghost" style="width:100%" onclick="go(\'home\')">Browse without signing in →</button>' +
    '<p style="text-align:center;font-size:.78rem;color:var(--soft);margin-top:.6rem">You can read all content. A token is only needed when saving.</p>' +
    '</div></div>';
};

/* --- Home --- */
screens.home = function() {
  return '<main>' +
    '<h1>What would you like to edit?</h1>' +
    renderStatus() +
    '<div class="home-grid">' +
    '<div class="home-card" onclick="loadList(\'product\')">' +
    '<div class="icon">🛍️</div><h2>Products</h2>' +
    '<p>Edit prices, descriptions, photos, and gallery images for your sticker sheets.</p></div>' +
    '<div class="home-card" onclick="loadList(\'post\')">' +
    '<div class="icon">✍️</div><h2>Blog posts</h2>' +
    '<p>Write and publish posts, set cover images, dates, and drafts.</p></div>' +
    '</div>' +
    '<p style="margin-top:2rem;color:var(--soft);font-size:.85rem">After saving, Cloudflare rebuilds the live site — about 1–2 min. ' +
    '<a href="https://github.com/' + OWNER + '/' + REPO + '/actions" target="_blank" rel="noopener" style="color:var(--pink)">Watch the build →</a></p>' +
    '</main>';
};

/* --- List (cards) --- */
screens.list = function() {
  var type  = screenData.type;
  var items = screenData.items;
  var error = screenData.error;
  var label = type === 'product' ? 'Products' : 'Blog posts';
  var crumb = '<div class="breadcrumb"><a onclick="go(\'home\')">Home</a> › ' + label + '</div>';

  if (error) return '<main>' + crumb +
    '<div class="status error">' + esc(error) + '</div>' +
    '<button class="btn btn-ghost" style="margin-top:.5rem" onclick="loadList(\'' + type + '\')">Try again</button></main>';

  if (!items) return '<main>' + crumb +
    '<div class="loading"><div class="spinner"></div><br>Loading…</div></main>';

  if (!items.length) return '<main>' + crumb +
    '<p style="color:var(--soft)">No files found.</p></main>';

  var cards = items.map(function(item) {
    return type === 'product' ? renderProductCard(item) : renderPostCard(item);
  }).join('');

  return '<main>' + crumb + renderStatus() +
    '<div class="list-cards">' + cards + '</div></main>';
};

function renderProductCard(item) {
  var f  = item.file;
  var fm = item.fm || {};
  var title = fm.title || f.name.replace(/\.md$/, '').replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
  var cat   = fm.category ? fm.category.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }) : '';
  var badges = '';
  if (fm.featured)       badges += '<span class="badge badge-featured">⭐ Featured</span>';
  if (fm.compareAtPrice) badges += '<span class="badge badge-sale">Sale</span>';
  var priceHtml = fm.price != null
    ? '<span class="list-card-price">₹' + fm.price +
      (fm.compareAtPrice ? ' <span style="font-size:.78rem;font-weight:400;color:var(--soft);text-decoration:line-through">₹' + fm.compareAtPrice + '</span>' : '') +
      '</span>'
    : '<span></span>';
  return '<div class="list-card">' +
    '<div class="list-card-body">' +
    '<div class="list-card-title">' + esc(title) + '</div>' +
    (cat ? '<div class="list-card-meta">' + esc(cat) + '</div>' : '') +
    (fm.description ? '<div class="list-card-desc">' + esc(fm.description) + '</div>' : '') +
    (badges ? '<div class="badges">' + badges + '</div>' : '') +
    '</div>' +
    '<div class="list-card-footer">' +
    priceHtml +
    '<button class="btn btn-ghost btn-sm" onclick="loadEdit(\'product\',\'' + esc(f.path) + '\')">Edit →</button>' +
    '</div></div>';
}

function renderPostCard(item) {
  var f  = item.file;
  var fm = item.fm || {};
  var title = fm.title || f.name.replace(/\.md$/, '').replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
  var dateStr = '';
  if (fm.date) {
    try { dateStr = new Date(fm.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }); }
    catch(e) { dateStr = String(fm.date); }
  }
  var badges = fm.draft ? '<span class="badge badge-draft">Draft</span>' : '';
  var tagBadges = (fm.tags || []).slice(0, 3).map(function(t) {
    return '<span class="badge badge-tag">' + esc(t) + '</span>';
  }).join('');
  return '<div class="list-card">' +
    '<div class="list-card-body">' +
    '<div class="list-card-title">' + esc(title) + '</div>' +
    (dateStr ? '<div class="list-card-meta">' + esc(dateStr) + '</div>' : '') +
    (fm.description ? '<div class="list-card-desc">' + esc(fm.description) + '</div>' : '') +
    ((badges || tagBadges) ? '<div class="badges">' + badges + tagBadges + '</div>' : '') +
    '</div>' +
    '<div class="list-card-footer"><span></span>' +
    '<button class="btn btn-ghost btn-sm" onclick="loadEdit(\'post\',\'' + esc(f.path) + '\')">Edit →</button>' +
    '</div></div>';
}

