---
// Decap CMS admin — config is served from /admin/config.yml
// OAuth is handled by Cloudflare Pages Functions at /api/auth and /api/callback
// Setup guide: docs/decap-cms-setup.md
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager · Curvy Noodle</title>
    <!-- Pin the config URL so Decap loads it regardless of trailing slash on /admin -->
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/decap-cms@3/dist/decap-cms.js"
    ></script>
  </body>
</html>
