/* ============================================================
   Tag pill helpers
   ============================================================ */
function renderTagPills() {
  var box = document.getElementById('tags-pill-box');
  if (!box) return;
  var pillsHtml = currentTags.map(function(t, i) {
    return '<span class="tag-chip">' + esc(t) +
      '<button type="button" class="tag-chip-remove" onclick="removeTag(' + i + ')" title="Remove">×</button>' +
      '</span>';
  }).join('');
  box.innerHTML = pillsHtml +
    '<input type="text" class="tag-pill-input" id="tag-input" placeholder="' +
    (currentTags.length ? 'Add another…' : 'Add a tag…') + '" />';

  var inp = document.getElementById('tag-input');
  if (!inp) return;
  inp.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      var val = inp.value.replace(/,/g, '').trim();
      if (val) { addTag(val); }
    } else if (e.key === 'Backspace' && inp.value === '' && currentTags.length) {
      removeTag(currentTags.length - 1);
    }
  });
  inp.addEventListener('blur', function() {
    var val = inp.value.replace(/,/g, '').trim();
    if (val) { addTag(val); }
  });
  box.addEventListener('click', function() { inp.focus(); });
}

function addTag(val) {
  val = val.trim();
  if (val && currentTags.indexOf(val) === -1) {
    currentTags.push(val);
    renderTagPills();
    var inp = document.getElementById('tag-input');
    if (inp) { inp.value = ''; inp.focus(); }
  }
}

function removeTag(idx) {
  currentTags.splice(idx, 1);
  renderTagPills();
  var inp = document.getElementById('tag-input');
  if (inp) inp.focus();
}

/* ============================================================
   Image picker
   ============================================================ */
async function openImagePicker(folder, targetId) {
  if (document.getElementById('img-picker')) return;

  var overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'img-picker';
  overlay.innerHTML =
    '<div class="modal">' +
    '<div class="modal-header">' +
    '<h3>Choose an image</h3>' +
    '<label class="btn btn-ghost btn-sm" style="cursor:pointer" title="Upload a new image (requires sign in)">' +
    '⬆ Upload<input type="file" id="upload-input" accept="image/*" style="display:none"></label>' +
    '<button class="btn btn-ghost btn-sm" onclick="closeImagePicker()">✕ Close</button>' +
    '</div>' +
    '<div class="modal-body" id="picker-body">' +
    '<div class="loading"><div class="spinner"></div><br>Loading images…</div>' +
    '</div></div>';

  document.body.appendChild(overlay);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeImagePicker(); });

  var uploadInput = document.getElementById('upload-input');
  if (uploadInput) {
    uploadInput.addEventListener('change', function() {
      if (uploadInput.files && uploadInput.files[0]) {
        uploadImage(folder, targetId, uploadInput.files[0]);
      }
    });
  }

  await refreshPickerGrid(folder, targetId);
}

async function refreshPickerGrid(folder, targetId) {
  var pickerBody = document.getElementById('picker-body');
  if (!pickerBody) return;
  try {
    var files = await ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/public/' + folder + '?ref=' + BRANCH);
    var imgs = files.filter(function(f) { return /\.(png|jpe?g|gif|webp|svg)$/i.test(f.name); });
    if (!imgs.length) {
      pickerBody.innerHTML = '<p style="color:var(--soft)">No images found in this folder yet. Use ⬆ Upload above to add one.</p>';
      return;
    }
    var grid = imgs.map(function(f) {
      var path = '/' + folder + '/' + f.name;
      return '<div class="img-thumb" onclick="pickImage(\'' + esc(targetId) + '\',\'' + esc(path) + '\')" title="' + esc(f.name) + '">' +
        '<img src="' + esc(f.download_url) + '" loading="lazy" alt="' + esc(f.name) + '" />' +
        '<div class="img-name">' + esc(f.name) + '</div></div>';
    }).join('');
    pickerBody.innerHTML = '<div class="img-grid">' + grid + '</div>';
  } catch(err) {
    pickerBody.innerHTML = '<div class="status error">Failed to load images: ' + esc(err.message) + '</div>';
  }
}

function closeImagePicker() {
  var el = document.getElementById('img-picker');
  if (el) el.remove();
}

function pickImage(targetId, path) {
  var el = document.getElementById(targetId);
  if (el) { el.value = path; el.dispatchEvent(new Event('input')); }
  closeImagePicker();
}

async function uploadImage(folder, targetId, file) {
  if (!token) {
    closeImagePicker();
    showTokenPrompt();
    return;
  }
  var pickerBody = document.getElementById('picker-body');
  if (pickerBody) pickerBody.innerHTML = '<div class="loading"><div class="spinner"></div><br>Uploading ' + esc(file.name) + '…</div>';

  var reader = new FileReader();
  reader.onload = async function() {
    try {
      var base64 = reader.result.split(',')[1];
      var apiPath = '/repos/' + OWNER + '/' + REPO + '/contents/public/' + folder + '/' + file.name;
      var sha;
      try { var existing = await ghFetch(apiPath + '?ref=' + BRANCH); sha = existing.sha; } catch(e) {}
      var body = { message: 'Upload image: ' + file.name, content: base64, branch: BRANCH };
      if (sha) body.sha = sha;
      await ghFetch(apiPath, { method: 'PUT', body: JSON.stringify(body) });
      var path = '/' + folder + '/' + file.name;
      pickImage(targetId, path);
      showStatus('success', '✓ Uploaded ' + file.name);
    } catch(e) {
      var pb = document.getElementById('picker-body');
      if (pb) pb.innerHTML = '<div class="status error">Upload failed: ' + esc(e.message) + '</div>';
    }
  };
  reader.onerror = function() {
    var pb = document.getElementById('picker-body');
    if (pb) pb.innerHTML = '<div class="status error">Could not read the file.</div>';
  };
  reader.readAsDataURL(file);
}

/* ============================================================
   Actions
   ============================================================ */
function bindEvents() {
  var loginBtn = document.getElementById('login-btn');
  if (loginBtn) {
    loginBtn.addEventListener('click', handleLogin);
    var tokInput = document.getElementById('tok-input');
    if (tokInput) tokInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') handleLogin();
    });
  }

  var bodyArea = document.getElementById('f-body');
  if (bodyArea && typeof EasyMDE !== 'undefined') {
    mdeInstance = new EasyMDE({
      element: bodyArea,
      spellChecker: false,
      autosave: { enabled: false },
      toolbar: [
        'bold', 'italic', 'heading', '|',
        'quote', 'unordered-list', 'ordered-list', '|',
        'link', '|', 'preview', 'side-by-side', 'fullscreen', '|', 'guide'
      ],
      status: false,
      minHeight: '220px',
      placeholder: 'Write the full description here…',
    });
  }

  if (document.getElementById('tags-pill-box')) {
    renderTagPills();
  }
}

async function handleLogin() {
  var val = (document.getElementById('tok-input').value || '').trim();
  if (!val) {
    statusMsg = { type: 'error', text: 'Please enter a token.' };
    render();
    return;
  }
  var btn = document.getElementById('login-btn');
  btn.disabled = true; btn.textContent = 'Verifying…';
  try {
    var res = await fetch('https://api.github.com/repos/' + OWNER + '/' + REPO, {
      headers: { Authorization: 'token ' + val, Accept: 'application/vnd.github.v3+json' }
    });
    if (!res.ok) throw new Error('Invalid token or no access to this repo.');
    token = val;
    sessionStorage.setItem('gh_token', val);
    go('home');
  } catch(err) {
    statusMsg = { type: 'error', text: err.message };
    render();
    var input = document.getElementById('tok-input');
    if (input) input.value = val;
  }
}

async function loadList(type) {
  go('list', { type: type });
  var dir = type === 'product' ? PRODUCTS_DIR : BLOG_DIR;
  try {
    var files = await listFiles(dir);
    var md = files.filter(function(f) { return f.name.endsWith('.md'); });
    // Fetch all files in parallel to populate rich card data
    var items = await Promise.all(md.map(async function(f) {
      try {
        var result = await getFile(f.path);
        var parsed = parseMd(result.content);
        return { file: f, fm: parsed.fm };
      } catch(e) {
        return { file: f, fm: {} };
      }
    }));
    // Sort: blog posts by date desc, products by title
    if (type === 'post') {
      items.sort(function(a, b) {
        return String(b.fm.date || '').localeCompare(String(a.fm.date || ''));
      });
    } else {
      items.sort(function(a, b) {
        return (a.fm.title || a.file.name).localeCompare(b.fm.title || b.file.name);
      });
    }
    go('list', { type: type, items: items });
  } catch(err) {
    go('list', { type: type, error: err.message });
  }
}

async function loadEdit(type, filePath) {
  currentTags = [];
  go('edit-' + type, { filePath: filePath });
  try {
    var result = await getFile(filePath);
    var parsed = parseMd(result.content);
    currentTags = parsed.fm.tags || [];
    go('edit-' + type, { filePath: filePath, fm: parsed.fm, body: parsed.body, sha: result.sha });
  } catch(err) {
    go('edit-' + type, { filePath: filePath, error: err.message });
  }
}

function addGalleryItem() {
  var list = document.getElementById('gallery-list');
  var idx  = list.querySelectorAll('.gallery-src').length;
  var div  = document.createElement('div');
  div.className = 'list-item';
  div.innerHTML =
    '<div class="grow gallery-item">' +
    '<div class="field"><label>Image path</label>' +
    '<div class="input-with-btn">' +
    '<input type="text" class="gallery-src" id="gallery-src-' + idx + '" data-idx="' + idx + '" placeholder="/images/products/…" />' +
    '<button type="button" class="btn btn-ghost btn-sm" onclick="openImagePicker(\'images/products\',\'gallery-src-' + idx + '\')">Browse</button>' +
    '</div></div>' +
    '<div class="field"><label>Alt text</label>' +
    '<input type="text" class="gallery-alt" data-idx="' + idx + '" placeholder="Describe the image" /></div>' +
    '</div>' +
    '<button class="btn-remove" onclick="removeItem(this)">×</button>';
  list.appendChild(div);
}

function removeItem(btn) {
  btn.closest('.list-item').remove();
}

function collectProductForm() {
  var srcs    = document.querySelectorAll('.gallery-src');
  var alts    = document.querySelectorAll('.gallery-alt');
  var gallery = [];
  srcs.forEach(function(src, i) {
    var s = src.value.trim();
    if (s) gallery.push({ src: s, alt: alts[i] ? alts[i].value.trim() : '' });
  });

  var cp = parseFloat(document.getElementById('f-compare-price').value);
  var fm = {
    title:       document.getElementById('f-title').value.trim(),
    price:       parseFloat(document.getElementById('f-price').value) || 0,
    category:    document.getElementById('f-category').value,
    tags:        currentTags.slice(),
    description: document.getElementById('f-description').value.trim(),
    featured:    document.getElementById('f-featured').checked,
    image:       document.getElementById('f-image').value.trim(),
    imageAlt:    document.getElementById('f-imageAlt').value.trim(),
    gallery:     gallery,
    dimensions:  document.getElementById('f-dimensions').value.trim(),
    material:    document.getElementById('f-material').value.trim(),
  };
  if (!isNaN(cp) && cp > 0) fm.compareAtPrice = cp;
  return { fm: fm, body: mdeInstance ? mdeInstance.value() : document.getElementById('f-body').value };
}

function collectPostForm() {
  var fm = {
    title:         document.getElementById('f-title').value.trim(),
    description:   document.getElementById('f-description').value.trim(),
    date:          document.getElementById('f-date').value,
    draft:         document.getElementById('f-draft').checked,
    tags:          currentTags.slice(),
    coverImage:    document.getElementById('f-coverImage').value.trim(),
    coverImageAlt: document.getElementById('f-coverImageAlt').value.trim(),
  };
  return { fm: fm, body: mdeInstance ? mdeInstance.value() : document.getElementById('f-body').value };
}

async function handleSave() {
  if (!token) { showTokenPrompt(); return; }

  var saveBtn    = document.getElementById('save-btn');
  var saveStatus = document.getElementById('save-status');
  var sha        = document.getElementById('f-sha').value;
  var filePath   = document.getElementById('f-filepath').value;
  var type       = screen === 'edit-product' ? 'product' : 'post';
  var slug       = filePath.split('/').pop().replace(/\.md$/, '');

  saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
  saveStatus.textContent = '';

  try {
    var collected = type === 'product' ? collectProductForm() : collectPostForm();
    var content = buildMd(collected.fm, collected.body);
    await putFile(filePath, content, sha, 'Update ' + type + ': ' + slug);
    saveStatus.textContent = '✓ Saved! Site is rebuilding…';
    saveBtn.textContent = 'Save & publish'; saveBtn.disabled = false;
    var refreshed = await getFile(filePath);
    document.getElementById('f-sha').value = refreshed.sha;
  } catch(err) {
    saveBtn.disabled = false; saveBtn.textContent = 'Save & publish';
    showStatus('error', 'Save failed: ' + err.message);
  }
}

function showTokenPrompt() {
  if (document.getElementById('token-prompt')) return;
  var anchor = document.querySelector('.form-actions');
  if (!anchor) return;
  var div = document.createElement('div');
  div.id = 'token-prompt';
  div.style.cssText = 'margin-top:.75rem;padding:.85rem 1rem;background:#fff8f8;border:1px solid var(--border);border-radius:8px;';
  div.innerHTML =
    '<p style="font-size:.85rem;font-weight:600;margin-bottom:.4rem">Sign in to save</p>' +
    '<p style="font-size:.8rem;color:var(--soft);margin-bottom:.65rem" id="tp-msg">Paste your GitHub token — it will be remembered for this tab.</p>' +
    '<div style="display:flex;gap:.5rem">' +
    '<input type="password" id="inline-token" placeholder="github_pat_…" style="flex:1;padding:.45rem .65rem;border:1px solid var(--border);border-radius:6px;font-size:.88rem;outline:none" />' +
    '<button class="btn btn-primary btn-sm" id="tp-btn" onclick="confirmTokenAndSave()">Save</button>' +
    '</div>';
  anchor.insertAdjacentElement('afterend', div);
  var inp = document.getElementById('inline-token');
  inp.focus();
  inp.addEventListener('keydown', function(e) { if (e.key === 'Enter') confirmTokenAndSave(); });
}

async function confirmTokenAndSave() {
  var val = (document.getElementById('inline-token').value || '').trim();
  if (!val) return;
  var btn = document.getElementById('tp-btn');
  var msg = document.getElementById('tp-msg');
  btn.disabled = true; btn.textContent = 'Verifying…';
  try {
    var res = await fetch('https://api.github.com/repos/' + OWNER + '/' + REPO, {
      headers: { Authorization: 'token ' + val, Accept: 'application/vnd.github.v3+json' }
    });
    if (!res.ok) throw new Error('Invalid token or no access to this repo.');
    token = val;
    sessionStorage.setItem('gh_token', val);
    document.getElementById('header-nav').innerHTML =
      '<button class="btn btn-ghost btn-sm" onclick="go(\'home\')">Home</button>' +
      '<button class="btn btn-ghost btn-sm" onclick="go(\'help\')">Help</button>' +
      '<button class="btn btn-ghost btn-sm" onclick="logout()">Sign out</button>';
    document.getElementById('token-prompt').remove();
    handleSave();
  } catch(err) {
    btn.disabled = false; btn.textContent = 'Save';
    msg.textContent = err.message;
    msg.style.color = 'var(--danger)';
  }
}

/* ============================================================
   Boot
   ============================================================ */
render();
</script>
</body>
</html>
