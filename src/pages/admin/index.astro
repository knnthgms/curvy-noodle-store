---
// Standalone admin page — no BaseLayout, full HTML document
// Talks to the GitHub API directly from the browser using a PAT stored in sessionStorage
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curvy Noodle · Admin</title>
  <script is:inline src="https://cdn.jsdelivr.net/npm/js-yaml@4/dist/js-yaml.min.js"></script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pink:      #d98a8a;
      --pink-dark: #b86b6b;
      --bg:        #f7f4f0;
      --card:      #ffffff;
      --border:    #e2dbd4;
      --text:      #2c2a27;
      --soft:      #7a746e;
      --danger:    #c0392b;
      --success:   #2e7d32;
      --radius:    12px;
      --shadow:    0 2px 10px rgba(0,0,0,.08);
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
    }

    /* ---------- layout ---------- */
    header {
      background: var(--card);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    header .logo { font-weight: 700; font-size: 1.1rem; }
    header .logo span { color: var(--pink); }
    header nav { margin-left: auto; display: flex; gap: .5rem; align-items: center; }

    main { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem; }

    /* ---------- cards / sections ---------- */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem;
    }
    .card + .card { margin-top: 1.25rem; }

    h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem; }
    h2 { font-size: 1.15rem; font-weight: 600; margin-bottom: 1rem; }

    /* ---------- buttons ---------- */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .5rem 1.1rem;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: .9rem;
      font-weight: 500;
      transition: opacity .15s, background .15s;
      text-decoration: none;
    }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    .btn-primary { background: var(--pink); color: #fff; }
    .btn-primary:hover:not(:disabled) { background: var(--pink-dark); }
    .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
    .btn-ghost:hover { background: var(--bg); }
    .btn-sm { padding: .35rem .75rem; font-size: .82rem; }

    /* ---------- forms ---------- */
    .field { margin-bottom: 1.1rem; }
    .field label {
      display: block;
      font-size: .85rem;
      font-weight: 600;
      color: var(--soft);
      text-transform: uppercase;
      letter-spacing: .04em;
      margin-bottom: .35rem;
    }
    .field input[type=text],
    .field input[type=number],
    .field input[type=date],
    .field input[type=password],
    .field select,
    .field textarea {
      width: 100%;
      padding: .55rem .75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      font-size: .95rem;
      color: var(--text);
      transition: border-color .15s;
    }
    .field input:focus,
    .field select:focus,
    .field textarea:focus { outline: none; border-color: var(--pink); }
    .field textarea { resize: vertical; min-height: 90px; font-family: inherit; }
    .field small { display: block; margin-top: .3rem; color: var(--soft); font-size: .8rem; }
    .field code { background: #f0ebe5; padding: .1em .35em; border-radius: 4px; font-size: .82em; }

    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    /* checkbox */
    .check-label {
      display: flex;
      align-items: center;
      gap: .5rem;
      cursor: pointer;
      font-size: .95rem;
    }
    .check-label input { width: 16px; height: 16px; accent-color: var(--pink); cursor: pointer; }

    /* ---------- dynamic lists (tags, gallery) ---------- */
    .list-items { display: flex; flex-direction: column; gap: .5rem; }
    .list-item {
      display: flex;
      gap: .5rem;
      align-items: flex-start;
    }
    .list-item .grow { flex: 1; }
    .btn-remove {
      padding: .45rem .6rem;
      border-radius: 6px;
      background: #fee2e2;
      color: var(--danger);
      border: none;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .btn-remove:hover { background: #fecaca; }
    .add-item-btn {
      margin-top: .5rem;
      background: transparent;
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: .45rem 1rem;
      cursor: pointer;
      color: var(--soft);
      font-size: .88rem;
      width: 100%;
    }
    .add-item-btn:hover { border-color: var(--pink); color: var(--pink); background: #fdf5f5; }

    /* gallery sub-fields */
    .gallery-item { background: var(--bg); border-radius: 8px; padding: .75rem; width: 100%; }
    .gallery-item .field { margin-bottom: .6rem; }
    .gallery-item .field:last-child { margin-bottom: 0; }

    /* ---------- item list ---------- */
    .item-list { list-style: none; }
    .item-list li {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .7rem 0;
      border-bottom: 1px solid var(--border);
    }
    .item-list li:last-child { border-bottom: none; }
    .item-list .item-title { flex: 1; font-weight: 500; font-size: .95rem; }
    .item-list .item-meta { font-size: .82rem; color: var(--soft); }

    /* ---------- status ---------- */
    .status {
      padding: .75rem 1rem;
      border-radius: 8px;
      font-size: .9rem;
      margin-bottom: 1.25rem;
    }
    .status.success { background: #e8f5e9; color: var(--success); border: 1px solid #c8e6c9; }
    .status.error   { background: #ffebee; color: var(--danger);  border: 1px solid #ffcdd2; }
    .status.info    { background: #e3f2fd; color: #1565c0;        border: 1px solid #bbdefb; }

    /* ---------- login ---------- */
    .login-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 56px);
      padding: 2rem 1rem;
    }
    .login-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 2rem;
      width: 100%;
      max-width: 440px;
    }
    .login-box h1 { text-align: center; margin-bottom: .5rem; }
    .login-box p  { text-align: center; color: var(--soft); font-size: .9rem; margin-bottom: 1.5rem; }

    /* ---------- home grid ---------- */
    .home-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .home-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem;
      cursor: pointer;
      transition: border-color .15s, box-shadow .15s;
    }
    .home-card:hover { border-color: var(--pink); box-shadow: 0 4px 16px rgba(217,138,138,.2); }
    .home-card .icon { font-size: 2.2rem; margin-bottom: .5rem; }
    .home-card h2 { margin: 0 0 .25rem; font-size: 1.1rem; }
    .home-card p { color: var(--soft); font-size: .88rem; margin: 0; }

    /* ---------- breadcrumb ---------- */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .88rem;
      color: var(--soft);
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--pink); text-decoration: none; cursor: pointer; }
    .breadcrumb a:hover { text-decoration: underline; }

    /* ---------- loading ---------- */
    .loading { text-align: center; padding: 3rem; color: var(--soft); }
    .spinner {
      display: inline-block;
      width: 32px;
      height: 32px;
      border: 3px solid var(--border);
      border-top-color: var(--pink);
      border-radius: 50%;
      animation: spin .7s linear infinite;
      margin-bottom: .75rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ---------- form actions ---------- */
    .form-actions {
      display: flex;
      gap: .75rem;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      margin-top: 1.5rem;
    }
    .form-actions .spacer { flex: 1; }

    @media (max-width: 600px) {
      .home-grid { grid-template-columns: 1fr; }
      .field-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<header>
  <div class="logo">🍜 Curvy Noodle <span>Admin</span></div>
  <nav id="header-nav"></nav>
</header>

<div id="app"></div>

<script is:inline>
/* ============================================================
   Config
   ============================================================ */
const OWNER        = 'knnthgms';
const REPO         = 'curvy-noodle-store';
const BRANCH       = 'main';
const PRODUCTS_DIR = 'src/content/products';
const BLOG_DIR     = 'src/content/blog';

/* ============================================================
   State
   ============================================================ */
let token      = sessionStorage.getItem('gh_token') || '';
let screen     = token ? 'home' : 'login';
let screenData = {};
let statusMsg  = null;

/* ============================================================
   GitHub API helpers
   ============================================================ */
async function ghFetch(path, opts) {
  opts = opts || {};
  const res = await fetch('https://api.github.com' + path, Object.assign({}, opts, {
    headers: Object.assign({
      Authorization: 'token ' + token,
      Accept: 'application/vnd.github.v3+json',
      'Content-Type': 'application/json',
    }, opts.headers || {}),
  }));
  if (!res.ok) {
    const err = await res.json().catch(function() { return {}; });
    throw new Error(err.message || 'GitHub error ' + res.status);
  }
  return res.json();
}

async function listFiles(dir) {
  return ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/' + dir + '?ref=' + BRANCH);
}

async function getFile(filePath) {
  const data = await ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/' + filePath + '?ref=' + BRANCH);
  const raw = atob(data.content.replace(/\n/g, ''));
  let content;
  try { content = decodeURIComponent(escape(raw)); } catch(e) { content = raw; }
  return { content: content, sha: data.sha, path: data.path };
}

async function putFile(filePath, content, sha, message) {
  let encoded;
  try { encoded = btoa(unescape(encodeURIComponent(content))); }
  catch(e) { encoded = btoa(content); }
  await ghFetch('/repos/' + OWNER + '/' + REPO + '/contents/' + filePath, {
    method: 'PUT',
    body: JSON.stringify({ message: message, content: encoded, sha: sha, branch: BRANCH }),
  });
}

/* ============================================================
   Markdown / YAML helpers
   ============================================================ */
function parseMd(raw) {
  const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
  if (!m) return { fm: {}, body: raw };
  try { return { fm: jsyaml.load(m[1]) || {}, body: m[2] }; }
  catch(e) { return { fm: {}, body: raw }; }
}

function buildMd(fm, body) {
  const yaml = jsyaml.dump(fm, { lineWidth: -1, noCompatMode: true });
  return '---\n' + yaml.trimEnd() + '\n---\n' + body;
}

/* ============================================================
   Utilities
   ============================================================ */
function esc(s) {
  if (s == null) return '';
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function go(s, data) {
  screen = s;
  screenData = data || {};
  statusMsg = null;
  render();
}

function render() {
  document.getElementById('app').innerHTML = screens[screen]();
  document.getElementById('header-nav').innerHTML = token
    ? '<button class="btn btn-ghost btn-sm" onclick="go(\'home\')">Home</button>' +
      '<button class="btn btn-ghost btn-sm" onclick="logout()">Sign out</button>'
    : '';
  bindEvents();
}

function logout() {
  sessionStorage.removeItem('gh_token');
  token = '';
  go('login');
}

function showStatus(type, text) {
  statusMsg = { type: type, text: text };
  const existing = document.getElementById('status-msg');
  const div = document.createElement('div');
  div.className = 'status ' + type;
  div.id = 'status-msg';
  div.textContent = text;
  if (existing) {
    existing.replaceWith(div);
  } else {
    const container = document.querySelector('main') || document.querySelector('.login-box');
    if (container) container.prepend(div);
  }
}

function renderStatus() {
  if (!statusMsg) return '';
  return '<div class="status ' + statusMsg.type + '" id="status-msg">' + esc(statusMsg.text) + '</div>';
}

/* ============================================================
   Screens
   ============================================================ */
var screens = {};

/* --- Login --- */
screens.login = function() {
  return '<div class="login-wrap"><div class="login-box">' +
    '<h1>🍜 Admin</h1>' +
    '<p>Sign in with a GitHub personal access token that has <strong>Contents: Read &amp; Write</strong> permission for this repo.</p>' +
    renderStatus() +
    '<div class="field"><label>GitHub Personal Access Token</label>' +
    '<input type="password" id="tok-input" placeholder="github_pat_…" autocomplete="off" />' +
    '<small>Create one at <a href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener">github.com/settings/tokens</a> — fine-grained, this repo only, Contents: Read &amp; Write. Saved only for this browser tab.</small></div>' +
    '<button class="btn btn-primary" id="login-btn" style="width:100%">Sign in</button>' +
    '</div></div>';
};

/* --- Home --- */
screens.home = function() {
  return '<main><h1>What would you like to edit?</h1>' +
    renderStatus() +
    '<div class="home-grid">' +
    '<div class="home-card" onclick="loadList(\'product\')">' +
    '<div class="icon">🛍️</div><h2>Products</h2>' +
    '<p>Edit prices, descriptions, photos, and gallery images for your sticker sheets.</p></div>' +
    '<div class="home-card" onclick="loadList(\'post\')">' +
    '<div class="icon">✍️</div><h2>Blog posts</h2>' +
    '<p>Write and publish posts, set cover images, dates, and drafts.</p></div>' +
    '</div>' +
    '<p style="margin-top:2rem;color:var(--soft);font-size:.85rem">After saving, Cloudflare rebuilds the live site automatically — about 1–2 minutes. ' +
    '<a href="https://github.com/' + OWNER + '/' + REPO + '/actions" target="_blank" rel="noopener" style="color:var(--pink)">Watch the build →</a></p>' +
    '</main>';
};

/* --- List --- */
screens.list = function() {
  var type = screenData.type;
  var files = screenData.files;
  var error = screenData.error;
  var label = type === 'product' ? 'Products' : 'Blog posts';
  var crumb = '<div class="breadcrumb"><a onclick="go(\'home\')">Home</a> › ' + label + '</div>';

  if (error) return '<main>' + crumb + '<div class="status error">' + esc(error) + '</div>' +
    '<button class="btn btn-ghost" onclick="loadList(\'' + type + '\')">Try again</button></main>';

  if (!files) return '<main>' + crumb +
    '<div class="loading"><div class="spinner"></div><br>Loading from GitHub…</div></main>';

  var items = files.map(function(f) {
    var slug = f.name.replace(/\.md$/, '');
    var title = slug.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
    return '<li><span class="item-title">' + esc(title) + '</span>' +
      '<span class="item-meta">' + esc(f.name) + '</span>' +
      '<button class="btn btn-ghost btn-sm" onclick="loadEdit(\'' + type + '\',\'' + esc(f.path) + '\')">Edit</button></li>';
  }).join('');

  return '<main>' + crumb + renderStatus() +
    '<div class="card"><h2>' + label + '</h2>' +
    '<ul class="item-list">' + (items || '<li>No files found.</li>') + '</ul></div></main>';
};

/* --- Edit Product --- */
screens['edit-product'] = function() {
  var d = screenData;
  var crumb = '<div class="breadcrumb"><a onclick="go(\'home\')">Home</a> › ' +
    '<a onclick="loadList(\'product\')">Products</a> › ' + esc((d.filePath || '').split('/').pop().replace(/\.md$/, '')) + '</div>';

  if (d.error) return '<main>' + crumb + '<div class="status error">' + esc(d.error) + '</div></main>';
  if (!d.fm) return '<main>' + crumb + '<div class="loading"><div class="spinner"></div><br>Loading…</div></main>';

  var fm = d.fm; var body = d.body || ''; var sha = d.sha; var filePath = d.filePath;
  var tags = fm.tags || [];
  var gallery = fm.gallery || [];

  var tagsHtml = tags.map(function(t, i) {
    return '<div class="list-item"><div class="grow"><input type="text" class="tag-input" data-idx="' + i + '" value="' + esc(t) + '" placeholder="Tag" /></div>' +
      '<button class="btn-remove" data-type="tag" data-idx="' + i + '" onclick="removeItem(\'tag\',this)">×</button></div>';
  }).join('');

  var galleryHtml = gallery.map(function(g, i) {
    return '<div class="list-item"><div class="grow gallery-item">' +
      '<div class="field"><label>Image path</label><input type="text" class="gallery-src" data-idx="' + i + '" value="' + esc(g.src || '') + '" placeholder="/images/products/…" /></div>' +
      '<div class="field"><label>Alt text</label><input type="text" class="gallery-alt" data-idx="' + i + '" value="' + esc(g.alt || '') + '" placeholder="Describe the image" /></div>' +
      '</div><button class="btn-remove" data-type="gallery" data-idx="' + i + '" onclick="removeItem(\'gallery\',this)">×</button></div>';
  }).join('');

  var catOpts = [
    ['daily-activity','Daily Activity'],['emotion-mood','Emotion & Mood'],
    ['bundles','Bundles'],['planner-tracker','Planner Tracker']
  ].map(function(o) {
    return '<option value="' + o[0] + '"' + (fm.category === o[0] ? ' selected' : '') + '>' + o[1] + '</option>';
  }).join('');

  return '<main>' + crumb + renderStatus() +
    '<form id="edit-form"><input type="hidden" id="f-sha" value="' + esc(sha) + '" />' +
    '<input type="hidden" id="f-filepath" value="' + esc(filePath) + '" />' +

    '<div class="card"><h2>Basic info</h2>' +
    '<div class="field"><label>Product name *</label><input type="text" id="f-title" value="' + esc(fm.title || '') + '" required /></div>' +
    '<div class="field-row">' +
    '<div class="field"><label>Selling price (₹) *</label><input type="number" id="f-price" value="' + esc(fm.price || '') + '" min="1" required /></div>' +
    '<div class="field"><label>Original price — sale only (₹)</label><input type="number" id="f-compare-price" value="' + esc(fm.compareAtPrice || '') + '" min="1" />' +
    '<small>Fill in to show a "Save X%" badge. Leave blank when not on sale.</small></div></div>' +
    '<div class="field"><label>Collection</label><select id="f-category">' + catOpts + '</select></div>' +
    '<div class="field"><label>Short description *</label><textarea id="f-description" rows="3" maxlength="200" required>' + esc(fm.description || '') + '</textarea>' +
    '<small>Shown on product cards and in Google results. Max 200 characters.</small></div>' +
    '<div class="field"><label class="check-label"><input type="checkbox" id="f-featured"' + (fm.featured ? ' checked' : '') + ' /> Show on home page</label></div>' +
    '</div>' +

    '<div class="card"><h2>Main photo</h2>' +
    '<div class="field"><label>Image path *</label><input type="text" id="f-image" value="' + esc(fm.image || '') + '" placeholder="/images/products/…" required />' +
    '<small>Drop the file in <code>public/images/products/</code>, then paste the path here.</small></div>' +
    '<div class="field"><label>Alt text *</label><input type="text" id="f-imageAlt" value="' + esc(fm.imageAlt || '') + '" required /></div>' +
    '</div>' +

    '<div class="card"><h2>Gallery photos</h2>' +
    '<p style="color:var(--soft);font-size:.88rem;margin-bottom:1rem">These appear in the photo carousel. Add the main photo as the first entry.</p>' +
    '<div class="list-items" id="gallery-list">' + galleryHtml + '</div>' +
    '<button type="button" class="add-item-btn" onclick="addItem(\'gallery\')">+ Add photo</button></div>' +

    '<div class="card"><h2>Tags</h2>' +
    '<div class="list-items" id="tags-list">' + tagsHtml + '</div>' +
    '<button type="button" class="add-item-btn" onclick="addItem(\'tag\')">+ Add tag</button></div>' +

    '<div class="card"><h2>Details</h2><div class="field-row">' +
    '<div class="field"><label>Dimensions</label><input type="text" id="f-dimensions" value="' + esc(fm.dimensions || '') + '" placeholder="A5 sheet; stickers 1.5–2.5 cm" /></div>' +
    '<div class="field"><label>Material</label><input type="text" id="f-material" value="' + esc(fm.material || '') + '" placeholder="Premium matte paper, handmade in India" /></div>' +
    '</div></div>' +

    '<div class="card"><h2>Full description (Markdown)</h2>' +
    '<div class="field"><textarea id="f-body" rows="12" style="font-family:monospace;font-size:.88rem">' + esc(body) + '</textarea>' +
    '<small>Supports Markdown: **bold**, *italic*, [links](url), etc.</small></div></div>' +

    '<div class="form-actions">' +
    '<button type="button" class="btn btn-ghost" onclick="loadList(\'product\')">← Back</button>' +
    '<div class="spacer"></div>' +
    '<span id="save-status" style="color:var(--soft);font-size:.88rem"></span>' +
    '<button type="button" class="btn btn-primary" id="save-btn" onclick="handleSave()">Save &amp; publish</button>' +
    '</div></form></main>';
};

/* --- Edit Post --- */
screens['edit-post'] = function() {
  var d = screenData;
  var crumb = '<div class="breadcrumb"><a onclick="go(\'home\')">Home</a> › ' +
    '<a onclick="loadList(\'post\')">Blog posts</a> › ' + esc((d.filePath || '').split('/').pop().replace(/\.md$/, '')) + '</div>';

  if (d.error) return '<main>' + crumb + '<div class="status error">' + esc(d.error) + '</div></main>';
  if (!d.fm) return '<main>' + crumb + '<div class="loading"><div class="spinner"></div><br>Loading…</div></main>';

  var fm = d.fm; var body = d.body || ''; var sha = d.sha; var filePath = d.filePath;
  var tags = fm.tags || [];

  var tagsHtml = tags.map(function(t, i) {
    return '<div class="list-item"><div class="grow"><input type="text" class="tag-input" data-idx="' + i + '" value="' + esc(t) + '" placeholder="Tag" /></div>' +
      '<button class="btn-remove" onclick="removeItem(\'tag\',this)">×</button></div>';
  }).join('');

  return '<main>' + crumb + renderStatus() +
    '<form id="edit-form"><input type="hidden" id="f-sha" value="' + esc(sha) + '" />' +
    '<input type="hidden" id="f-filepath" value="' + esc(filePath) + '" />' +

    '<div class="card"><h2>Post info</h2>' +
    '<div class="field"><label>Title *</label><input type="text" id="f-title" value="' + esc(fm.title || '') + '" required /></div>' +
    '<div class="field"><label>Short description *</label><textarea id="f-description" rows="2" maxlength="200" required>' + esc(fm.description || '') + '</textarea>' +
    '<small>Shown in Google results and on the blog listing. Max 200 characters.</small></div>' +
    '<div class="field-row">' +
    '<div class="field"><label>Publish date *</label><input type="date" id="f-date" value="' + esc(fm.date || '') + '" required /></div>' +
    '<div class="field" style="display:flex;align-items:flex-end;padding-bottom:.55rem">' +
    '<label class="check-label"><input type="checkbox" id="f-draft"' + (fm.draft ? ' checked' : '') + ' /> Draft — hide from website</label></div>' +
    '</div></div>' +

    '<div class="card"><h2>Cover image</h2>' +
    '<div class="field"><label>Image path *</label><input type="text" id="f-coverImage" value="' + esc(fm.coverImage || '') + '" placeholder="/images/blog/…" required />' +
    '<small>Drop the file in <code>public/images/blog/</code>, then paste the path here.</small></div>' +
    '<div class="field"><label>Alt text *</label><input type="text" id="f-coverImageAlt" value="' + esc(fm.coverImageAlt || '') + '" required /></div>' +
    '</div>' +

    '<div class="card"><h2>Tags</h2>' +
    '<div class="list-items" id="tags-list">' + tagsHtml + '</div>' +
    '<button type="button" class="add-item-btn" onclick="addItem(\'tag\')">+ Add tag</button></div>' +

    '<div class="card"><h2>Post content (Markdown)</h2>' +
    '<div class="field"><textarea id="f-body" rows="20" style="font-family:monospace;font-size:.88rem">' + esc(body) + '</textarea>' +
    '<small>Write in Markdown. ## for headings, **bold**, *italic*, [links](url), etc.</small></div></div>' +

    '<div class="form-actions">' +
    '<button type="button" class="btn btn-ghost" onclick="loadList(\'post\')">← Back</button>' +
    '<div class="spacer"></div>' +
    '<span id="save-status" style="color:var(--soft);font-size:.88rem"></span>' +
    '<button type="button" class="btn btn-primary" id="save-btn" onclick="handleSave()">Save &amp; publish</button>' +
    '</div></form></main>';
};

/* ============================================================
   Actions
   ============================================================ */
function bindEvents() {
  var loginBtn = document.getElementById('login-btn');
  if (loginBtn) {
    loginBtn.addEventListener('click', handleLogin);
    var tokInput = document.getElementById('tok-input');
    if (tokInput) tokInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') handleLogin();
    });
  }
}

async function handleLogin() {
  var val = (document.getElementById('tok-input').value || '').trim();
  if (!val) {
    statusMsg = { type: 'error', text: 'Please enter a token.' };
    render();
    return;
  }
  var btn = document.getElementById('login-btn');
  btn.disabled = true; btn.textContent = 'Verifying…';
  try {
    var res = await fetch('https://api.github.com/repos/' + OWNER + '/' + REPO, {
      headers: { Authorization: 'token ' + val, Accept: 'application/vnd.github.v3+json' }
    });
    if (!res.ok) throw new Error('Invalid token or no access to this repo.');
    token = val;
    sessionStorage.setItem('gh_token', val);
    go('home');
  } catch(err) {
    statusMsg = { type: 'error', text: err.message };
    render();
    // Restore the token value so the user doesn't have to retype it
    var input = document.getElementById('tok-input');
    if (input) input.value = val;
  }
}

async function loadList(type) {
  go('list', { type: type });
  var dir = type === 'product' ? PRODUCTS_DIR : BLOG_DIR;
  try {
    var files = await listFiles(dir);
    var md = files.filter(function(f) { return f.name.endsWith('.md'); })
      .sort(function(a, b) { return a.name.localeCompare(b.name); });
    go('list', { type: type, files: md });
  } catch(err) {
    go('list', { type: type, error: err.message });
  }
}

async function loadEdit(type, filePath) {
  go('edit-' + type, { filePath: filePath });
  try {
    var result = await getFile(filePath);
    var parsed = parseMd(result.content);
    go('edit-' + type, { filePath: filePath, fm: parsed.fm, body: parsed.body, sha: result.sha });
  } catch(err) {
    go('edit-' + type, { filePath: filePath, error: err.message });
  }
}

function addItem(type) {
  if (type === 'tag') {
    var list = document.getElementById('tags-list');
    var idx = list.querySelectorAll('.tag-input').length;
    var div = document.createElement('div');
    div.className = 'list-item';
    div.innerHTML = '<div class="grow"><input type="text" class="tag-input" data-idx="' + idx + '" placeholder="Tag" /></div>' +
      '<button class="btn-remove" onclick="removeItem(\'tag\',this)">×</button>';
    list.appendChild(div);
  } else {
    var list = document.getElementById('gallery-list');
    var idx = list.querySelectorAll('.gallery-src').length;
    var div = document.createElement('div');
    div.className = 'list-item';
    div.innerHTML = '<div class="grow gallery-item">' +
      '<div class="field"><label>Image path</label><input type="text" class="gallery-src" data-idx="' + idx + '" placeholder="/images/products/…" /></div>' +
      '<div class="field"><label>Alt text</label><input type="text" class="gallery-alt" data-idx="' + idx + '" placeholder="Describe the image" /></div>' +
      '</div><button class="btn-remove" onclick="removeItem(\'gallery\',this)">×</button>';
    list.appendChild(div);
  }
}

function removeItem(type, btn) {
  btn.closest('.list-item').remove();
}

function collectProductForm() {
  var tags = Array.from(document.querySelectorAll('.tag-input'))
    .map(function(el) { return el.value.trim(); }).filter(Boolean);

  var srcs = document.querySelectorAll('.gallery-src');
  var alts = document.querySelectorAll('.gallery-alt');
  var gallery = [];
  srcs.forEach(function(src, i) {
    var s = src.value.trim();
    if (s) gallery.push({ src: s, alt: (alts[i] ? alts[i].value.trim() : '') });
  });

  var cp = parseFloat(document.getElementById('f-compare-price').value);
  var fm = {
    title:       document.getElementById('f-title').value.trim(),
    price:       parseFloat(document.getElementById('f-price').value) || 0,
    category:    document.getElementById('f-category').value,
    tags:        tags,
    description: document.getElementById('f-description').value.trim(),
    featured:    document.getElementById('f-featured').checked,
    image:       document.getElementById('f-image').value.trim(),
    imageAlt:    document.getElementById('f-imageAlt').value.trim(),
    gallery:     gallery,
    dimensions:  document.getElementById('f-dimensions').value.trim(),
    material:    document.getElementById('f-material').value.trim(),
  };
  if (!isNaN(cp) && cp > 0) fm.compareAtPrice = cp;
  return { fm: fm, body: document.getElementById('f-body').value };
}

function collectPostForm() {
  var tags = Array.from(document.querySelectorAll('.tag-input'))
    .map(function(el) { return el.value.trim(); }).filter(Boolean);
  var fm = {
    title:         document.getElementById('f-title').value.trim(),
    description:   document.getElementById('f-description').value.trim(),
    date:          document.getElementById('f-date').value,
    draft:         document.getElementById('f-draft').checked,
    tags:          tags,
    coverImage:    document.getElementById('f-coverImage').value.trim(),
    coverImageAlt: document.getElementById('f-coverImageAlt').value.trim(),
  };
  return { fm: fm, body: document.getElementById('f-body').value };
}

async function handleSave() {
  var saveBtn    = document.getElementById('save-btn');
  var saveStatus = document.getElementById('save-status');
  var sha        = document.getElementById('f-sha').value;
  var filePath   = document.getElementById('f-filepath').value;
  var type       = screen === 'edit-product' ? 'product' : 'post';
  var slug       = filePath.split('/').pop().replace(/\.md$/, '');

  saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
  saveStatus.textContent = '';

  try {
    var collected = type === 'product' ? collectProductForm() : collectPostForm();
    var content = buildMd(collected.fm, collected.body);
    await putFile(filePath, content, sha, 'Update ' + type + ': ' + slug);
    saveStatus.textContent = '✓ Saved! Site is rebuilding…';
    saveBtn.textContent = 'Save & publish'; saveBtn.disabled = false;
    // Refresh SHA so a second save works without reload
    var refreshed = await getFile(filePath);
    document.getElementById('f-sha').value = refreshed.sha;
  } catch(err) {
    saveBtn.disabled = false; saveBtn.textContent = 'Save & publish';
    showStatus('error', 'Save failed: ' + err.message);
  }
}

/* ============================================================
   Boot
   ============================================================ */
render();
</script>
</body>
</html>
