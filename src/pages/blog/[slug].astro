---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Comments from '@components/Comments.astro';
import RelatedNotes from '@components/RelatedNotes.astro';
import BlogCard from '@components/BlogCard.astro';
import YouTubeEmbed from '@components/YouTubeEmbed.astro';
import { SITE } from '@config';
import { getPublishedNotes, getPublishedPosts, postPath, type Post } from '@utils/collections';
import { formatClock, formatDate, isoDate, readingTime } from '@utils/format';
import { blogPostingSchema, breadcrumbSchema, faqSchema, videoSchema } from '@utils/schema';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are sorted newest-first, so "previous" = newer, "next" = older.
      newerPost: posts[index - 1] ?? null,
      olderPost: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: Post;
  newerPost: Post | null;
  olderPost: Post | null;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, coverImage, coverImageAlt, comments, updated, faq, video } = post.data;

// Related posts for internal linking: most shared tags first, then newest.
const allPosts = await getPublishedPosts();
const ownTags = new Set(post.data.tags.map((tag) => tag.toLowerCase()));
const relatedPosts = allPosts
  .filter((other) => other.id !== post.id)
  .map((other) => ({
    other,
    shared: other.data.tags.filter((tag) => ownTags.has(tag.toLowerCase())).length,
  }))
  .sort((a, b) => b.shared - a.shared || b.other.data.date.valueOf() - a.other.data.date.valueOf())
  .slice(0, 3)
  .map(({ other }) => other);

// Related Noodle Notes for the sidebar: notes sharing a tag first, then the latest.
const postTags = new Set(tags.map((tag) => tag.toLowerCase()));
const allNotes = await getPublishedNotes();
const relatedNotes = [
  ...allNotes.filter((note) => note.data.tags.some((tag) => postTags.has(tag.toLowerCase()))),
  ...allNotes,
]
  .filter((note, index, list) => list.indexOf(note) === index)
  .slice(0, 3);

const minutes = readingTime(post.body ?? '');
const path = postPath(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
if (video && video.chapters.length > 0) toc.unshift({ depth: 2, slug: 'video-chapters', text: 'Video chapters' });
if (faq.length > 0) toc.push({ depth: 2, slug: 'faq', text: 'Frequently asked questions' });
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const showUpdated = updated && isoDate(updated) !== isoDate(date);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  blogPostingSchema({ title, description, date, updated, url: path, image: coverImage, keywords: tags, wordCount, video }),
  ...(video ? [videoSchema(video, path)] : []),
  ...(faq.length > 0 ? [faqSchema(faq)] : []),
];

// Social share links (simple anchors — zero JavaScript needed).
const shareUrl = new URL(path, Astro.site).href;
const shareText = `${title} — ${SITE.name}`;
const shareLinks = [
  {
    label: 'Share on X',
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`,
  },
  {
    label: 'Share on Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
  },
  {
    label: 'Share on Pinterest',
    href: `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(shareUrl)}&description=${encodeURIComponent(shareText)}`,
  },
  {
    label: 'Share on WhatsApp',
    href: `https://wa.me/?text=${encodeURIComponent(`${shareText} ${shareUrl}`)}`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={coverImage}
  ogImageAlt={coverImageAlt}
  ogType="article"
  publishedTime={date}
  modifiedTime={updated ?? date}
  tags={tags}
  schemas={schemas}
>
  <article class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-[69rem]">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <header class="mx-auto mt-6 max-w-3xl text-center">
      <p class="text-ink-soft">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {
          showUpdated && (
            <>
              <span aria-hidden="true"> · </span>
              Updated <time datetime={isoDate(updated!)}>{formatDate(updated!)}</time>
            </>
          )
        }
        <span aria-hidden="true"> · </span>
        {minutes} min read
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-ink-soft">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Tags">
            {tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      video ? (
        <div class="mx-auto mt-8 max-w-3xl">
          <YouTubeEmbed youtubeId={video.youtubeId} title={video.title} />
        </div>
      ) : (
        <img
          src={coverImage}
          alt={coverImageAlt}
          width="1200"
          height="675"
          decoding="async"
          class="mx-auto mt-8 aspect-video w-full max-w-3xl rounded-3xl border-2 border-cream-dark bg-white object-cover"
        />
      )
    }

    <div class="mx-auto mt-10 max-w-5xl xl:flex xl:max-w-[80rem] xl:items-start xl:gap-10">
    <div class="flex min-w-0 flex-1 flex-col gap-10 lg:flex-row">
      {/* Table of contents */}
      {
        toc.length > 0 && (
          <nav
            aria-label="Table of contents"
            class="top-24 shrink-0 self-start rounded-3xl bg-cream-dark/60 p-6 lg:sticky lg:w-64"
          >
            <h2 class="font-display text-lg font-bold">In this post</h2>
            <ol class="mt-3 space-y-2 text-sm">
              {toc.map((heading) => (
                <li class:list={[heading.depth === 3 && 'pl-4']}>
                  <a
                    href={`#${heading.slug}`}
                    class="text-ink-soft underline-offset-4 hover:text-pink-deep hover:underline"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="min-w-0 flex-1">
        {
          video && video.chapters.length > 0 && (
            <section aria-labelledby="video-chapters" class="mb-10 rounded-3xl border-2 border-cream-dark bg-white p-6">
              <h2 id="video-chapters" class="font-display text-2xl font-bold">Video chapters</h2>
              <p class="mt-1 text-ink-soft">Jump straight to the part you need ({video.duration.replace('PT', '').replace('M', ' min ').replace('S', ' sec').trim()} in total).</p>
              <ol class="mt-4 space-y-2">
                {video.chapters.map((chapter) => (
                  <li class="flex gap-3">
                    <a
                      href={`https://www.youtube.com/watch?v=${video.youtubeId}&t=${chapter.start}s`}
                      class="w-12 shrink-0 font-display font-bold text-pink-deep underline-offset-4 hover:underline"
                      rel="noopener"
                    >
                      {formatClock(chapter.start)}
                    </a>
                    <span>{chapter.name}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        {
          faq.length > 0 && (
            <section id="faq" aria-labelledby="faq-heading" class="mt-12">
              <h2 id="faq-heading" class="font-display text-3xl font-bold">Frequently asked questions</h2>
              <div class="mt-4 space-y-4">
                {faq.map((item) => (
                  <div class="rounded-3xl border-2 border-cream-dark bg-white p-5">
                    <h3 class="font-display text-xl font-bold">{item.question}</h3>
                    <p class="mt-2 text-lg">{item.answer}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {/* Share buttons */}
        <div class="mt-10 rounded-3xl bg-blush/50 p-6">
          <h2 class="font-display text-lg font-bold">Enjoyed this? Pass it along 💌</h2>
          <ul class="mt-3 flex flex-wrap gap-3">
            {
              shareLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block rounded-full border-2 border-ink/20 bg-white px-4 py-2 text-sm font-semibold transition hover:border-pink-deep hover:text-pink-deep"
                  >
                    {link.label.replace('Share on ', '')}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {comments && <Comments slug={`blog/${post.id}`} />}
      </div>
    </div>

    <RelatedNotes notes={relatedNotes} />
    </div>

    {/* Related posts (internal links help readers and search engines find more) */}
    {
      relatedPosts.length > 0 && (
        <section aria-labelledby="related-posts-heading" class="mx-auto mt-14 max-w-5xl">
          <h2 id="related-posts-heading" class="font-display text-3xl font-bold">More from the Planning Nook 📓</h2>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((related) => <BlogCard post={related} />)}
          </div>
        </section>
      )
    }

    {/* Previous / next navigation */}
    <nav aria-label="More posts" class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2">
      {
        newerPost ? (
          <a
            href={postPath(newerPost)}
            class="rounded-3xl border-2 border-cream-dark bg-white p-5 transition hover:border-pink-deep"
          >
            <span class="text-sm text-ink-soft">← Newer post</span>
            <span class="mt-1 block font-display font-bold">{newerPost.data.title}</span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )
      }
      {
        olderPost && (
          <a
            href={postPath(olderPost)}
            class="rounded-3xl border-2 border-cream-dark bg-white p-5 text-right transition hover:border-pink-deep"
          >
            <span class="text-sm text-ink-soft">Older post →</span>
            <span class="mt-1 block font-display font-bold">{olderPost.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
