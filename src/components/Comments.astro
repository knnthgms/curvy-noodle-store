---
/**
 * Anonymous comments for a blog post, Noodle Note or product. Visitors pick any
 * name, no login, and can attach one photo. `slug` is "<collection>/<entry id>",
 * e.g. "notes/my-note" or "shop/my-product". Comments are loaded and saved
 * through /api/comments (functions/api/comments.js). Photo comments are held
 * until approved at /admin/comments; text comments appear straight away.
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<section
  class="mt-12 rounded-3xl border-2 border-cream-dark bg-white p-6 sm:p-8"
  aria-labelledby="comments-heading"
  data-comments
  data-slug={slug}
>
  <h2 id="comments-heading" class="font-display text-2xl font-bold">
    Comments 💬 <span class="text-ink-soft" data-comments-count></span>
  </h2>
  <p class="mt-1 text-ink-soft">No sign-up needed. Pick any name you like.</p>

  <p class="mt-6 text-ink-soft" data-comments-status role="status">Loading comments…</p>
  <ol class="mt-4 space-y-4" data-comments-list></ol>

  <form class="mt-8 space-y-4 border-t-2 border-cream-dark pt-6" data-comments-form hidden novalidate>
    <h3 class="font-display text-xl font-bold">Leave a comment</h3>
    <div>
      <label for="comment-name" class="block font-semibold">Name</label>
      <input
        id="comment-name"
        name="name"
        type="text"
        required
        maxlength="40"
        autocomplete="nickname"
        class="mt-1 w-full rounded-2xl border-2 border-cream-dark bg-cream px-4 py-3 focus:border-pink-deep focus:outline-none"
      />
    </div>
    <div>
      <label for="comment-message" class="block font-semibold">Comment</label>
      <textarea
        id="comment-message"
        name="message"
        maxlength="1000"
        rows="4"
        class="mt-1 w-full rounded-2xl border-2 border-cream-dark bg-cream px-4 py-3 focus:border-pink-deep focus:outline-none"
      ></textarea>
      <p class="mt-1 text-sm text-ink-soft">Links aren't allowed, to keep spam out.</p>
    </div>

    <div>
      <span class="block font-semibold">Photo <span class="font-normal text-ink-soft">(optional)</span></span>
      <input
        id="comment-photo"
        name="photo"
        type="file"
        accept="image/*"
        class="sr-only"
        data-comments-photo
      />
      <div class="mt-1 flex flex-wrap items-center gap-3">
        <label for="comment-photo" class="btn-secondary cursor-pointer" data-comments-photo-label>
          📷 Add a photo
        </label>
        <button type="button" class="font-semibold text-pink-deep underline underline-offset-4" data-comments-photo-remove hidden>
          Remove photo
        </button>
      </div>
      <img
        alt="Preview of the photo you're adding"
        class="mt-3 hidden max-h-56 w-auto max-w-full rounded-2xl border-2 border-cream-dark"
        data-comments-photo-preview
      />
      <p class="mt-1 text-sm text-ink-soft">
        Photos are checked before they appear, so yours may take a little while to show up.
      </p>
    </div>

    {/* Honeypot: hidden from people, bots tend to fill it in. */}
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="comment-website">Leave this empty</label>
      <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn-primary" data-comments-submit>Post comment</button>
      <p class="font-semibold" data-comments-message role="status"></p>
    </div>
  </form>
</section>

<script>
  interface Comment {
    id: string;
    name: string;
    message: string;
    createdAt: string;
    image?: string;
    parentId?: string;
    owner?: boolean;
  }

  const NAME_KEY = 'curvy-noodle-comment-name';
  const MAX_SOURCE_BYTES = 20 * 1024 * 1024; // photos straight off a phone can be big
  const MAX_UPLOAD_BYTES = 1.4 * 1024 * 1024;
  const MAX_SIDE = 1400;

  const readName = (): string => {
    try {
      return localStorage.getItem(NAME_KEY) ?? '';
    } catch {
      return '';
    }
  };

  const saveName = (name: string): void => {
    try {
      localStorage.setItem(NAME_KEY, name);
    } catch {
      /* storage can be blocked; the name just won't be remembered */
    }
  };

  const formatWhen = (iso: string): string =>
    new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

  /**
   * Shrinks a photo and re-saves it as a JPEG in the browser. This keeps uploads
   * small and removes hidden data such as location from the file.
   */
  const preparePhoto = async (file: File): Promise<Blob> => {
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, MAX_SIDE / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    const context = canvas.getContext('2d');
    if (!context) throw new Error('no canvas');
    context.fillStyle = '#ffffff'; // transparent PNGs would otherwise turn black
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();
    for (const quality of [0.85, 0.75, 0.65, 0.5]) {
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
      if (blob && blob.size <= MAX_UPLOAD_BYTES) return blob;
    }
    throw new Error('too big');
  };

  /**
   * Turns web addresses in the shop owner's replies into links. Only the owner
   * can post links (visitors can't), and only http(s) addresses are linked.
   */
  const withLinks = (text: string): DocumentFragment => {
    const fragment = document.createDocumentFragment();
    let last = 0;
    for (const match of text.matchAll(/https?:\/\/[^\s<>"']+/g)) {
      const start = match.index ?? 0;
      const url = match[0].replace(/[.,!?;:)]+$/, ''); // keep trailing punctuation out of the link
      fragment.append(text.slice(last, start));
      const link = document.createElement('a');
      link.href = url;
      link.textContent = url;
      link.rel = 'noopener nofollow ugc';
      link.className = 'font-semibold text-pink-deep underline underline-offset-4';
      fragment.append(link);
      last = start + url.length;
    }
    fragment.append(text.slice(last));
    return fragment;
  };

  const INPUT_CLASS =
    'mt-1 w-full rounded-2xl border-2 border-cream-dark bg-cream px-4 py-3 focus:border-pink-deep focus:outline-none';

  const init = (root: HTMLElement): void => {
    const slug = root.dataset.slug ?? '';
    const status = root.querySelector<HTMLElement>('[data-comments-status]');
    const list = root.querySelector<HTMLOListElement>('[data-comments-list]');
    const count = root.querySelector<HTMLElement>('[data-comments-count]');
    const form = root.querySelector<HTMLFormElement>('[data-comments-form]');
    const message = root.querySelector<HTMLElement>('[data-comments-message]');
    const submit = root.querySelector<HTMLButtonElement>('[data-comments-submit]');
    const photoInput = root.querySelector<HTMLInputElement>('[data-comments-photo]');
    const photoLabel = root.querySelector<HTMLElement>('[data-comments-photo-label]');
    const photoRemove = root.querySelector<HTMLButtonElement>('[data-comments-photo-remove]');
    const photoPreview = root.querySelector<HTMLImageElement>('[data-comments-photo-preview]');
    if (!status || !list || !count || !form || !message || !submit) return;
    if (!photoInput || !photoLabel || !photoRemove || !photoPreview) return;

    const nameInput = form.elements.namedItem('name') as HTMLInputElement;
    const textInput = form.elements.namedItem('message') as HTMLTextAreaElement;
    nameInput.value = readName();

    let items: Comment[] = [];
    let photo: Blob | null = null;
    let previewUrl = '';
    // Set while a chosen photo is being resized, so posting can wait for it.
    let preparing: Promise<void> | null = null;
    // Closes the reply form that is currently open (only one at a time).
    let closeOpenReply: (() => void) | null = null;

    const clearPhoto = (): void => {
      photo = null;
      photoInput.value = '';
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = '';
      photoPreview.removeAttribute('src');
      photoPreview.classList.add('hidden');
      photoRemove.hidden = true;
      photoLabel.textContent = '📷 Add a photo';
    };

    const usePhoto = async (file: File): Promise<void> => {
      message.textContent = 'Getting your photo ready…';
      submit.disabled = true;
      try {
        photo = await preparePhoto(file);
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = URL.createObjectURL(photo);
        photoPreview.src = previewUrl;
        photoPreview.classList.remove('hidden');
        photoRemove.hidden = false;
        photoLabel.textContent = '📷 Change photo';
        message.textContent = '';
      } catch {
        clearPhoto();
        message.textContent = "Sorry, I couldn't use that photo. Please try a JPG or PNG.";
      } finally {
        submit.disabled = false;
        preparing = null;
      }
    };

    photoInput.addEventListener('change', () => {
      const file = photoInput.files?.[0];
      if (!file) return;
      message.textContent = '';
      if (!file.type.startsWith('image/') || file.size > MAX_SOURCE_BYTES) {
        clearPhoto();
        message.textContent = 'Please choose a photo (JPG or PNG) under 20 MB.';
        return;
      }
      preparing = usePhoto(file);
    });

    photoRemove.addEventListener('click', () => {
      clearPhoto();
      message.textContent = '';
    });

    /** Sends a comment or reply. Returns the saved comment, or the server's pending/error answer. */
    const send = async (data: FormData) => {
      const response = await fetch('/api/comments', { method: 'POST', body: data });
      const result = (await response.json()) as { comment?: Comment | null; pending?: boolean; error?: string };
      return { ok: response.ok || response.status === 202, result };
    };

    // Everything below is built with textContent, never innerHTML, so comment
    // text can't inject markup.
    const buildReplyForm = (target: Comment, onDone: () => void): HTMLFormElement => {
      const replyForm = document.createElement('form');
      replyForm.className = 'mt-3 space-y-3 rounded-2xl border-2 border-cream-dark bg-white p-4';
      replyForm.noValidate = true;

      const heading = document.createElement('p');
      heading.className = 'text-sm font-semibold';
      heading.textContent = `Replying to ${target.name}`;

      const name = document.createElement('input');
      name.type = 'text';
      name.name = 'name';
      name.maxLength = 40;
      name.required = true;
      name.setAttribute('autocomplete', 'nickname');
      name.placeholder = 'Your name';
      name.setAttribute('aria-label', 'Your name');
      name.className = INPUT_CLASS;
      name.value = readName();

      const text = document.createElement('textarea');
      text.name = 'message';
      text.maxLength = 1000;
      text.rows = 3;
      text.placeholder = 'Write a reply (no links, please)';
      text.setAttribute('aria-label', `Your reply to ${target.name}`);
      text.className = INPUT_CLASS;
      // Replying to a reply keeps it in the same thread, so say who it's for.
      if (target.parentId) text.value = `@${target.name} `;

      // Honeypot: hidden from people, bots tend to fill it in.
      const trap = document.createElement('div');
      trap.className = 'absolute -left-[9999px]';
      trap.setAttribute('aria-hidden', 'true');
      const trapInput = document.createElement('input');
      trapInput.type = 'text';
      trapInput.name = 'website';
      trapInput.tabIndex = -1;
      trapInput.autocomplete = 'off';
      trap.append(trapInput);

      const buttons = document.createElement('div');
      buttons.className = 'flex flex-wrap items-center gap-3';
      const post = document.createElement('button');
      post.type = 'submit';
      post.className = 'btn-primary';
      post.textContent = 'Post reply';
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.className = 'btn-secondary';
      cancel.textContent = 'Cancel';
      cancel.addEventListener('click', onDone);
      const note = document.createElement('p');
      note.className = 'font-semibold';
      note.setAttribute('role', 'status');
      buttons.append(post, cancel, note);

      replyForm.append(heading, name, text, trap, buttons);

      replyForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const who = name.value.trim();
        const body = text.value.trim();
        if (!who || !body || body === `@${target.name}`) {
          note.textContent = 'Please add your name and a reply.';
          return;
        }
        post.disabled = true;
        note.textContent = 'Posting…';
        try {
          const data = new FormData();
          data.set('slug', slug);
          data.set('name', who);
          data.set('message', body);
          data.set('parentId', target.id);
          data.set('website', trapInput.value);
          const { ok, result } = await send(data);
          if (!ok) {
            note.textContent = result.error ?? 'Something went wrong. Please try again.';
            return;
          }
          saveName(who);
          if (result.comment) items.push(result.comment);
          closeOpenReply = null;
          render();
        } catch {
          note.textContent = 'Something went wrong. Please try again.';
        } finally {
          post.disabled = false;
        }
      });

      return replyForm;
    };

    const buildComment = (comment: Comment, isReply: boolean): HTMLLIElement => {
      const item = document.createElement('li');
      item.className = isReply ? 'rounded-2xl bg-white p-3' : 'rounded-2xl bg-cream p-4';

      const head = document.createElement('p');
      head.className = 'text-sm text-ink-soft';
      const author = document.createElement('strong');
      author.className = 'font-display text-base text-ink';
      author.textContent = comment.name;
      head.append(author);
      if (comment.owner) {
        const badge = document.createElement('span');
        badge.className = 'ml-2 rounded-full bg-pink px-2 py-0.5 text-xs font-bold text-white';
        badge.textContent = 'Author 🍜';
        head.append(badge);
      }
      const when = document.createElement('time');
      when.dateTime = comment.createdAt;
      when.textContent = formatWhen(comment.createdAt);
      head.append(' · ', when);
      item.append(head);

      if (comment.message) {
        const body = document.createElement('p');
        body.className = 'mt-1 whitespace-pre-line break-words';
        if (comment.owner) body.append(withLinks(comment.message));
        else body.textContent = comment.message;
        item.append(body);
      }
      if (comment.image) {
        const picture = document.createElement('img');
        picture.src = `/api/comments?image=${encodeURIComponent(comment.image)}`;
        picture.alt = `Photo shared by ${comment.name}`;
        picture.loading = 'lazy';
        picture.className = 'mt-3 max-h-96 w-auto max-w-full rounded-2xl border-2 border-cream-dark bg-white';
        item.append(picture);
      }

      const replyButton = document.createElement('button');
      replyButton.type = 'button';
      replyButton.className = 'mt-2 text-sm font-semibold text-pink-deep underline underline-offset-4';
      replyButton.textContent = 'Reply';
      replyButton.setAttribute('aria-label', `Reply to ${comment.name}`);
      replyButton.setAttribute('aria-expanded', 'false');
      const slot = document.createElement('div');
      replyButton.addEventListener('click', () => {
        if (replyButton.getAttribute('aria-expanded') === 'true') {
          closeOpenReply?.();
          return;
        }
        closeOpenReply?.();
        const replyForm = buildReplyForm(comment, () => closeOpenReply?.());
        slot.append(replyForm);
        replyButton.setAttribute('aria-expanded', 'true');
        closeOpenReply = () => {
          replyForm.remove();
          replyButton.setAttribute('aria-expanded', 'false');
          closeOpenReply = null;
        };
        (replyForm.elements.namedItem(comment.parentId ? 'message' : 'name') as HTMLElement | null)?.focus();
      });
      item.append(replyButton, slot);
      return item;
    };

    function render(): void {
      if (!list || !count || !status) return;
      list.innerHTML = '';
      const threads = items.filter((comment) => !comment.parentId);
      for (const top of threads) {
        const item = buildComment(top, false);
        const replies = items.filter((comment) => comment.parentId === top.id);
        if (replies.length > 0) {
          const thread = document.createElement('ol');
          thread.className = 'mt-4 space-y-3 border-l-2 border-cream-dark pl-4 sm:pl-6';
          thread.setAttribute('aria-label', `Replies to ${top.name}`);
          replies.forEach((reply) => thread.append(buildComment(reply, true)));
          item.append(thread);
        }
        list.append(item);
      }
      count.textContent = items.length > 0 ? `(${items.length})` : '';
      status.textContent = items.length === 0 ? 'No comments yet. Be the first! 🌸' : '';
    }

    const load = async (): Promise<void> => {
      try {
        const response = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
        if (response.status === 503 || response.status === 404) {
          status.textContent = 'Comments will be switched on soon. Check back!';
          return;
        }
        if (!response.ok) throw new Error(String(response.status));
        const data = (await response.json()) as { comments: Comment[] };
        items = data.comments;
        render();
        form.hidden = false;
      } catch {
        status.textContent = "Couldn't load comments right now. Please try again later.";
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (preparing) await preparing; // never post before a chosen photo is ready
      const name = nameInput.value.trim();
      const text = textInput.value.trim();
      if (!name || (!text && !photo)) {
        message.textContent = 'Please add your name and a comment or photo.';
        return;
      }
      submit.disabled = true;
      message.textContent = 'Posting…';
      try {
        const data = new FormData();
        data.set('slug', slug);
        data.set('name', name);
        data.set('message', text);
        data.set('website', (form.elements.namedItem('website') as HTMLInputElement).value);
        if (photo) data.set('image', photo, 'photo.jpg');
        const { ok, result } = await send(data);
        if (!ok) {
          message.textContent = result.error ?? 'Something went wrong. Please try again.';
          return;
        }
        saveName(name);
        textInput.value = '';
        clearPhoto();
        if (result.pending) {
          message.textContent = 'Thanks! Your photo comment will show up once it has been checked. 💌';
          return;
        }
        if (result.comment) items.push(result.comment);
        render();
        message.textContent = 'Thanks for commenting! 💌';
      } catch {
        message.textContent = 'Something went wrong. Please try again.';
      } finally {
        submit.disabled = false;
      }
    });

    void load();
  };

  document.querySelectorAll<HTMLElement>('[data-comments]').forEach(init);
</script>
