---
/**
 * Anonymous comments for a blog post or Noodle Note. Visitors pick any name,
 * no login. `slug` is "<collection>/<entry id>", e.g. "notes/my-note".
 * Comments are loaded and saved through /api/comments (functions/api/comments.js).
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<section
  class="mt-12 rounded-3xl border-2 border-cream-dark bg-white p-6 sm:p-8"
  aria-labelledby="comments-heading"
  data-comments
  data-slug={slug}
>
  <h2 id="comments-heading" class="font-display text-2xl font-bold">
    Comments 💬 <span class="text-ink-soft" data-comments-count></span>
  </h2>
  <p class="mt-1 text-ink-soft">No sign-up needed. Pick any name you like.</p>

  <p class="mt-6 text-ink-soft" data-comments-status role="status">Loading comments…</p>
  <ol class="mt-4 space-y-4" data-comments-list></ol>

  <form class="mt-8 space-y-4 border-t-2 border-cream-dark pt-6" data-comments-form hidden novalidate>
    <h3 class="font-display text-xl font-bold">Leave a comment</h3>
    <div>
      <label for="comment-name" class="block font-semibold">Name</label>
      <input
        id="comment-name"
        name="name"
        type="text"
        required
        maxlength="40"
        autocomplete="nickname"
        class="mt-1 w-full rounded-2xl border-2 border-cream-dark bg-cream px-4 py-3 focus:border-pink-deep focus:outline-none"
      />
    </div>
    <div>
      <label for="comment-message" class="block font-semibold">Comment</label>
      <textarea
        id="comment-message"
        name="message"
        required
        maxlength="1000"
        rows="4"
        class="mt-1 w-full rounded-2xl border-2 border-cream-dark bg-cream px-4 py-3 focus:border-pink-deep focus:outline-none"
      ></textarea>
      <p class="mt-1 text-sm text-ink-soft">Links aren't allowed, to keep spam out.</p>
    </div>
    {/* Honeypot: hidden from people, bots tend to fill it in. */}
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="comment-website">Leave this empty</label>
      <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn-primary" data-comments-submit>Post comment</button>
      <p class="font-semibold" data-comments-message role="status"></p>
    </div>
  </form>
</section>

<script>
  interface Comment {
    id: string;
    name: string;
    message: string;
    createdAt: string;
  }

  const NAME_KEY = 'curvy-noodle-comment-name';

  const readName = (): string => {
    try {
      return localStorage.getItem(NAME_KEY) ?? '';
    } catch {
      return '';
    }
  };

  const saveName = (name: string): void => {
    try {
      localStorage.setItem(NAME_KEY, name);
    } catch {
      /* storage can be blocked; the name just won't be remembered */
    }
  };

  const formatWhen = (iso: string): string =>
    new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

  const init = (root: HTMLElement): void => {
    const slug = root.dataset.slug ?? '';
    const status = root.querySelector<HTMLElement>('[data-comments-status]');
    const list = root.querySelector<HTMLOListElement>('[data-comments-list]');
    const count = root.querySelector<HTMLElement>('[data-comments-count]');
    const form = root.querySelector<HTMLFormElement>('[data-comments-form]');
    const message = root.querySelector<HTMLElement>('[data-comments-message]');
    const submit = root.querySelector<HTMLButtonElement>('[data-comments-submit]');
    if (!status || !list || !count || !form || !message || !submit) return;

    const nameInput = form.elements.namedItem('name') as HTMLInputElement;
    const textInput = form.elements.namedItem('message') as HTMLTextAreaElement;
    nameInput.value = readName();

    let total = 0;

    const updateCount = (): void => {
      count.textContent = total > 0 ? `(${total})` : '';
      status.textContent = total === 0 ? 'No comments yet. Be the first! 🌸' : '';
    };

    // Built with textContent, never innerHTML, so comment text can't inject markup.
    const addComment = (comment: Comment): void => {
      const item = document.createElement('li');
      item.className = 'rounded-2xl bg-cream p-4';
      const head = document.createElement('p');
      head.className = 'text-sm text-ink-soft';
      const author = document.createElement('strong');
      author.className = 'font-display text-base text-ink';
      author.textContent = comment.name;
      const when = document.createElement('time');
      when.dateTime = comment.createdAt;
      when.textContent = formatWhen(comment.createdAt);
      head.append(author, ' · ', when);
      const body = document.createElement('p');
      body.className = 'mt-1 whitespace-pre-line break-words';
      body.textContent = comment.message;
      item.append(head, body);
      list.appendChild(item);
      total += 1;
    };

    const load = async (): Promise<void> => {
      try {
        const response = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
        if (response.status === 503 || response.status === 404) {
          status.textContent = 'Comments will be switched on soon. Check back!';
          return;
        }
        if (!response.ok) throw new Error(String(response.status));
        const data = (await response.json()) as { comments: Comment[] };
        data.comments.forEach(addComment);
        updateCount();
        form.hidden = false;
      } catch {
        status.textContent = "Couldn't load comments right now. Please try again later.";
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = nameInput.value.trim();
      const text = textInput.value.trim();
      if (!name || !text) {
        message.textContent = 'Please add your name and a comment.';
        return;
      }
      submit.disabled = true;
      message.textContent = 'Posting…';
      try {
        const honeypot = (form.elements.namedItem('website') as HTMLInputElement).value;
        const response = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, name, message: text, website: honeypot }),
        });
        const data = (await response.json()) as { comment?: Comment | null; error?: string };
        if (!response.ok) {
          message.textContent = data.error ?? 'Something went wrong. Please try again.';
          return;
        }
        if (data.comment) addComment(data.comment);
        updateCount();
        saveName(name);
        textInput.value = '';
        message.textContent = 'Thanks for commenting! 💌';
      } catch {
        message.textContent = 'Something went wrong. Please try again.';
      } finally {
        submit.disabled = false;
      }
    });

    void load();
  };

  document.querySelectorAll<HTMLElement>('[data-comments]').forEach(init);
</script>
