---
import { SITE } from '@config';
import { postPath, type Post } from '@utils/collections';

/**
 * "Watch on YouTube" block shown at the bottom of every blog post, with a
 * View channel button. When another post has an embedded video, its thumbnail
 * is shown as the latest video.
 */
interface Props {
  /** The newest post that has a YouTube video (not the post being read). */
  latestVideoPost?: Post;
}

const { latestVideoPost } = Astro.props;
const video = latestVideoPost?.data.video;
---

<section
  id="youtube-channel"
  aria-labelledby="youtube-channel-heading"
  class="mx-auto mt-14 max-w-5xl overflow-hidden rounded-3xl border-2 border-cream-dark bg-blush/50"
>
  <div class="grid items-center gap-6 p-6 sm:p-8 md:grid-cols-[1fr_auto]">
    <div>
      <p class="chip bg-white">▶ YouTube</p>
      <h2 id="youtube-channel-heading" class="mt-3 font-display text-3xl font-bold">
        Watch Curvy Noodle on YouTube
      </h2>
      <p class="mt-2 max-w-xl text-lg text-ink-soft">
        Plan with me videos, notebook and planner setups, and sticker ideas. Come and plan along!
      </p>
      <a
        href={SITE.socials.youtube}
        target="_blank"
        rel="noopener"
        class="btn-primary mt-5"
        aria-label="View the Curvy Noodle YouTube channel (opens in a new tab)"
      >
        View channel
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      video && latestVideoPost && (
        <a
          href={postPath(latestVideoPost)}
          class="group block w-full max-w-xs rounded-2xl bg-white p-3 shadow-sm transition hover:-translate-y-1 hover:shadow-md md:w-64"
        >
          <span class="relative block overflow-hidden rounded-xl">
            <img
              src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
              alt=""
              width="480"
              height="360"
              loading="lazy"
              decoding="async"
              class="aspect-video w-full object-cover"
            />
            <span
              class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-pink-deep text-white shadow"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="ml-0.5 h-5 w-5" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
            </span>
          </span>
          <span class="mt-3 block text-xs font-bold uppercase tracking-wide text-ink-soft">Latest video</span>
          <span class="mt-1 block font-display leading-snug group-hover:text-pink-deep">{video.title}</span>
        </a>
      )
    }
  </div>
</section>
