---
import { NAV_LINKS, SITE } from '@config';

/** Sticky site header with desktop nav and a mobile hamburger menu. */
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

/**
 * Progressive desktop nav — links appear as the viewport widens.
 * The logo already links home, so '/' is desktop-only hidden.
 * Hamburger stays visible up to 2xl so overflow items are always reachable.
 */
const desktopBreakpoint: Record<string, string> = {
  '/shop':        '',                 // lg+  — always visible in desktop nav
  '/collections': '',                 // lg+
  '/blog':        '',                 // lg+
  '/notes':       '',                 // lg+
  '/about':       'hidden xl:block',  // xl+
  '/faq':         'hidden xl:block',  // xl+
  '/contact':     'hidden 2xl:block', // 2xl+
  // '/' is intentionally absent — logo covers home on all viewports
};
---

<header class="sticky top-0 z-40 border-b-2 border-cream-dark bg-cream/90 backdrop-blur">
  <p class="bg-pink-deep px-4 py-1.5 text-center text-sm font-semibold text-white">
    {SITE.announcement} 🚚
  </p>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2" aria-label={`${SITE.name} — home`}>
      <img
        src="/images/branding/favicon.PNG"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 object-contain"
        aria-hidden="true"
      />
      <span class="font-display text-lg font-bold leading-tight sm:text-xl">
        {SITE.name}
      </span>
    </a>

    <!-- Desktop nav: shows from lg; items appear progressively at wider breakpoints -->
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
            <li class={desktopBreakpoint[link.href] ?? ''}>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-4 py-2 font-display font-semibold transition hover:bg-noodle',
                  isActive(link.href) ? 'bg-pink text-white' : 'text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Cart icon + hamburger group -->
    <div class="flex items-center gap-1">
      <button
        id="cart-toggle"
        type="button"
        class="relative rounded-full p-2 transition hover:bg-noodle"
        aria-label="Open cart"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"></path>
        </svg>
        <span
          id="cart-badge"
          class="absolute -right-0.5 -top-0.5 hidden h-5 w-5 items-center justify-center rounded-full bg-pink-deep text-xs font-bold text-white"
          aria-live="polite"
          aria-label="items in cart"
        ></span>
      </button>

    <!-- Hamburger: visible below 2xl so overflow links are always reachable -->
    <button
      id="menu-toggle"
      type="button"
      class="rounded-full p-2 hover:bg-noodle 2xl:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Toggle menu</span>
      <svg
        class="h-6 w-6"
        data-icon="open"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        class="hidden h-6 w-6"
        data-icon="close"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    </div>{/* end cart+hamburger group */}
  </div>

  <!-- Mobile/overflow menu: full link list, hidden via CSS at 2xl -->
  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t-2 border-cream-dark 2xl:hidden" hidden>
    <ul class="space-y-1 px-4 py-3">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block rounded-2xl px-4 py-3 font-display text-lg font-semibold',
                isActive(link.href) ? 'bg-pink text-white' : 'hover:bg-noodle',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  import { getCart, cartCount, type CartItem } from '@utils/cart';

  // ── Cart badge ─────────────────────────────────────────────────────────────
  const cartBtn   = document.getElementById('cart-toggle') as HTMLButtonElement;
  const cartBadge = document.getElementById('cart-badge') as HTMLElement;

  function updateBadge(items: CartItem[]): void {
    const n = cartCount(items);
    if (n > 0) {
      cartBadge.textContent = String(n > 99 ? '99+' : n);
      cartBadge.classList.remove('hidden');
      cartBadge.classList.add('flex');
    } else {
      cartBadge.classList.add('hidden');
      cartBadge.classList.remove('flex');
    }
  }

  updateBadge(getCart());

  window.addEventListener('cart:change', ((e: CustomEvent<CartItem[]>) => {
    updateBadge(e.detail);
  }) as EventListener);

  cartBtn.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  // ── Hamburger menu ─────────────────────────────────────────────────────────
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const icons = toggle.querySelectorAll('svg');

    const setOpen = (open: boolean): void => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      menu.classList.toggle('hidden', !open);
      icons.forEach((icon) => {
        const isClose = icon.dataset.icon === 'close';
        icon.classList.toggle('hidden', isClose !== open);
      });
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
