---
import { getReviews } from '@utils/collections';

/**
 * Customer reviews as tiny one-line post-it notes (theme colours). Shows the
 * newest three. Renders nothing until there is at least one published review in
 * `src/content/reviews/` (add them in /admin → Reviews).
 */
const reviews = (await getReviews()).slice(0, 3);

// Note colours come from the site theme; each note gets its own colour and tilt.
const colours = ['bg-noodle', 'bg-blush', 'bg-sky'];
const tilts = ['-rotate-2', 'rotate-1', '-rotate-1'];
---

{
  reviews.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6" aria-labelledby="reviews-heading">
      <h2 id="reviews-heading" class="text-center font-display text-2xl font-bold">
        Sticky notes from fellow planners 💌
      </h2>

      <ul class="mt-6 flex flex-wrap items-start justify-center gap-x-6 gap-y-6">
        {reviews.map((review, index) => (
          <li
            class={`${tilts[index % tilts.length]} transition-transform duration-200 hover:-translate-y-0.5 hover:rotate-0 motion-reduce:transition-none`}
          >
            <figure
              class={`relative max-w-full px-5 pb-2.5 pt-5 text-ink shadow-[0_6px_12px_-6px_rgba(67,56,46,0.55)] ${colours[index % colours.length]}`}
            >
              {/* little strip of tape */}
              <span
                class="absolute -top-2 left-1/2 h-4 w-12 -translate-x-1/2 -rotate-3 bg-white/60 shadow-sm"
                aria-hidden="true"
              />
              <blockquote class="whitespace-nowrap font-hand text-xl leading-tight sm:text-2xl">
                “{review.data.quote}”
              </blockquote>
              <figcaption class="mt-1 font-display text-xs">
                {review.data.name}
                {review.data.location && <span class="font-sans font-normal text-ink-soft"> · {review.data.location}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}
